    }

    .calendar-day.has-entry {
        border-color: #22c55e;
        background: #ecfdf3;
    }

    .calendar-day.has-entry::after {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c55e;
        position: absolute;
        bottom: 6px;
        right: 6px;
    }

    .day-number {
        font-weight: 700;
    }

    .week-view {
        grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    .week-day {
        min-height: 80px;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .week-day .day-name {
        margin-top: 0.25rem;
        font-size: 0.75rem;
        color: #6b7280;
    }

    .year-grid {
        margin-top: 1rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }

