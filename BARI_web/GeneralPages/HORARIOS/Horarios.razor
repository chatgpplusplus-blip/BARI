@page "/horarios"
@using Npgsql
@using System.Globalization
@inject NpgsqlDataSource DataSource
@inject LaboratorioState LaboratorioState

<PageTitle>Horarios</PageTitle>

<section class="page-card">
    <h2>Horarios</h2>
    <p class="helper">
        Registro de entradas y salidas por docente o becario. Elige el personal, marca tus horas y controla el acumulado mensual.
    </p>
    <LaboratorioSelector />
</section>

@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <section class="page-card" style="margin-top:1rem;">
        <p class="error-note">Error: @_loadError</p>
    </section>
}

<section class="page-card" style="margin-top:1rem;">
    <div class="section-head">
        <h3>Selector de personal</h3>
        <span class="badge">@(_selectedPersonaNombre ?? "Sin selección")</span>
    </div>

    <div class="selector-grid">
        <div class="selector-card">
            <label class="selector-title">Tipo</label>
            <div class="radio-row">
                <label>
                    <input type="radio" name="tipoPersonal" value="docente" checked="@(_tipoSeleccionado == TipoPersona.Docente)" @onchange="OnTipoPersonaChanged" />
                    Docente
                </label>
                <label>
                    <input type="radio" name="tipoPersonal" value="becario" checked="@(_tipoSeleccionado == TipoPersona.Becario)" @onchange="OnTipoPersonaChanged" />
                    Becario
                </label>
            </div>
        </div>

        <div class="selector-card">
            <label class="selector-title">Selecciona</label>
            @if (_tipoSeleccionado == TipoPersona.Docente)
            {
                <select class="border p-1 form-control" @onchange="OnDocenteChanged">
                    <option value="">Docente...</option>
                    @foreach (var d in _docentes)
                    {
                        <option value="@d.Id" selected="@(_docenteIdSeleccionado == d.Id)">Docente #@d.Id (Usuario @d.UsuarioId)</option>
                    }
                </select>
            }
            else
            {
                <select class="border p-1 form-control" @onchange="OnBecarioChanged">
                    <option value="">Becario...</option>
                    @foreach (var b in _becarios)
                    {
                        <option value="@b.Id" selected="@(_becarioIdSeleccionado == b.Id)">Becario #@b.Id (Usuario @b.UsuarioId)</option>
                    }
                </select>
            }
        </div>

        <div class="selector-card">
            <label class="selector-title">Acumulado mensual</label>
            <div class="accumulated">
                <span class="accumulated-hours">@_horasAcumuladasMensual.ToString("0.00", CultureInfo.InvariantCulture)</span>
                <span class="accumulated-label">horas</span>
            </div>
            <div class="text-xs muted">@_rangoMesTexto</div>
        </div>
    </div>
</section>

<section class="page-card" style="margin-top:1rem;">
    <div class="calendar-header">
        <div>
            <h3>Calendario de horarios</h3>
            <div class="text-xs muted">Laboratorio actual: @_laboratorioNombre</div>
        </div>
        <div class="calendar-controls">
            <button class="btn" type="button" @onclick="GoPrev">←</button>
            <button class="btn" type="button" @onclick="GoToday">Hoy</button>
            <button class="btn" type="button" @onclick="GoNext">→</button>

            <select class="border p-1 form-control" @bind="_viewModeSeleccionado" @onchange="OnViewModeChanged">
                <option value="Mes">Vista mes</option>
                <option value="Semana">Vista semana</option>
                <option value="Ano">Vista año</option>
            </select>

            <select class="border p-1 form-control" @bind="_anioSeleccionado" @onchange="OnYearChanged">
                @foreach (var year in _yearsDisponibles)
                {
                    <option value="@year">@year</option>
                }
            </select>
        </div>
    </div>

    @if (_viewModeSeleccionado == ViewMode.Mes)
    {
        <div class="calendar-grid">
            @foreach (var dayName in _dayHeaders)
            {
                <div class="calendar-header-cell">@dayName</div>
            }
            @foreach (var day in BuildMonthDays(_anchorDate))
            {
                var hasEntry = DayHasEntries(day.Date);
                var isCurrentMonth = day.Month == _anchorDate.Month;
                <button class="calendar-day @(hasEntry ? "has-entry" : "") @(day.Date == _selectedDate?.Date ? "selected" : "") @(isCurrentMonth ? "" : "muted")"
                        type="button"
                        @onclick="() => OnDaySelected(day.Date)">
                    <span class="day-number">@day.Day</span>
                </button>
            }
        </div>
    }
    else if (_viewModeSeleccionado == ViewMode.Semana)
    {
        <div class="calendar-grid week-view">
            @foreach (var day in BuildWeekDays(_anchorDate))
            {
                var hasEntry = DayHasEntries(day.Date);
                <button class="calendar-day week-day @(hasEntry ? "has-entry" : "") @(day.Date == _selectedDate?.Date ? "selected" : "")"
                        type="button"
                        @onclick="() => OnDaySelected(day.Date)">
                    <span class="day-number">@day.Day</span>
                    <span class="day-name">@day.ToString("ddd", new CultureInfo("es-ES"))</span>
                </button>
            }
        </div>
    }
    else
    {
        <div class="year-grid">
            @foreach (var month in Enumerable.Range(1, 12))
            {
                var monthDate = new DateTime(_anchorDate.Year, month, 1);
                <div class="mini-month">
                    <div class="mini-month-title">@monthDate.ToString("MMMM", new CultureInfo("es-ES"))</div>
                    <div class="mini-grid">
                        @foreach (var day in BuildMonthDays(monthDate))
                        {
                            var hasEntry = DayHasEntries(day.Date);
                            var isCurrentMonth = day.Month == month;
                            <button class="mini-day @(hasEntry ? "has-entry" : "") @(isCurrentMonth ? "" : "muted")"
                                    type="button"
                                    @onclick="() => OnDaySelected(day.Date)">
                                @day.Day
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

@if (_selectedDate.HasValue)
{
    <section class="page-card" style="margin-top:1rem;">
        <div class="section-head">
            <h3>Registro del @(_selectedDate.Value.ToString("dd 'de' MMMM yyyy", new CultureInfo("es-ES")))</h3>
            <span class="badge">@(_tipoSeleccionado == TipoPersona.Docente ? "Docente" : "Becario")</span>
        </div>

        <div class="form-grid" style="margin-top:.75rem;">
            <div class="field">
                <label>Hora entrada</label>
                <input class="border p-1 form-control" type="time" @bind="_horaEntrada" />
            </div>
            <div class="field">
                <label>Hora salida</label>
                <input class="border p-1 form-control" type="time" @bind="_horaSalida" />
            </div>
            <div class="field full-span">
                <div class="exit-note">
                    Estás registrando una salida del laboratorio: <strong>@_laboratorioNombre</strong>.
                </div>
            </div>
            <div class="form-actions full-span">
                <button class="btn primary" type="button" @onclick="SaveHorarioAsync" disabled="@(!_puedeGuardarHorario)">Guardar</button>
                @if (!string.IsNullOrWhiteSpace(_msgGuardar))
                {
                    <span class="text-sm muted">@_msgGuardar</span>
                }
            </div>
        </div>

        @if (_tipoSeleccionado == TipoPersona.Becario)
        {
            <div class="class-blocks">
                <h4>Bloqueos por clases</h4>
                <p class="text-xs muted">Define intervalos donde el becario tiene clases para evitar choques.</p>

                <div class="form-grid" style="margin-top:.5rem;">
                    <div class="field">
                        <label>Desde</label>
                        <input class="border p-1 form-control" type="time" @bind="_claseInicio" />
                    </div>
                    <div class="field">
                        <label>Hasta</label>
                        <input class="border p-1 form-control" type="time" @bind="_claseFin" />
                    </div>
                    <div class="form-actions full-span">
                        <button class="btn" type="button" @onclick="AddClaseAsync" disabled="@(!_puedeGuardarClase)">Agregar bloqueo</button>
                        @if (!string.IsNullOrWhiteSpace(_msgClase))
                        {
                            <span class="text-sm muted">@_msgClase</span>
                        }
                    </div>
                </div>

                <div class="table-wrap" style="margin-top:.75rem;">
                    <table>
                        <thead>
                            <tr>
                                <th>Inicio</th>
                                <th>Fin</th>
                                <th style="width:120px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bloque in _bloquesClaseDelDia)
                            {
                                <tr>
                                    <td>@bloque.Inicio.ToString(@"hh\:mm")</td>
                                    <td>@bloque.Fin.ToString(@"hh\:mm")</td>
                                    <td>
                                        <button class="btn danger" type="button" @onclick="() => DeleteClaseAsync(bloque.Id)">Quitar</button>
                                    </td>
                                </tr>
                            }
                            @if (_bloquesClaseDelDia.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="muted">Sin bloqueos para este día.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="table-wrap" style="margin-top:1rem;">
            <table>
                <thead>
                    <tr>
                        <th>Entrada</th>
                        <th>Salida</th>
                        <th>Duración (hrs)</th>
                        <th style="width:120px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _entradasDelDia)
                    {
                        <tr>
                            <td>@entry.HoraInicio.ToString(@"hh\:mm")</td>
                            <td>@entry.HoraFin.ToString(@"hh\:mm")</td>
                            <td>@entry.Horas.ToString("0.00", CultureInfo.InvariantCulture)</td>
                            <td>
                                <button class="btn danger" type="button" @onclick="() => DeleteHorarioAsync(entry.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                    @if (_entradasDelDia.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="muted">No hay registros aún.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<style>
    .selector-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
    }

    .selector-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        padding: 0.75rem;
    }

