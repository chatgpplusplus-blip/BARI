    }

    .class-blocks {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px dashed #e5e7eb;
    }
</style>

@code {
    private sealed record PersonalItem(int Id, int UsuarioId);
    private sealed record HorarioEntry(long Id, DateTime Fecha, TimeSpan HoraInicio, TimeSpan HoraFin, double Horas);
    private sealed record ClaseBlock(long Id, DateTime Fecha, TimeSpan Inicio, TimeSpan Fin);

    private enum TipoPersona { Docente, Becario }
    private enum ViewMode { Mes, Semana, Ano }

    private readonly string[] _dayHeaders = new[] { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" };

    private List<PersonalItem> _docentes = new();
    private List<PersonalItem> _becarios = new();
    private List<HorarioEntry> _horarios = new();
    private List<ClaseBlock> _bloquesClase = new();

    private TipoPersona _tipoSeleccionado = TipoPersona.Docente;
    private int? _docenteIdSeleccionado;
    private int? _becarioIdSeleccionado;
    private DateTime _anchorDate = DateTime.Today;
    private DateTime? _selectedDate = DateTime.Today;
    private ViewMode _viewModeSeleccionado = ViewMode.Mes;

    private string _horaEntrada = "08:00";
    private string _horaSalida = "10:00";
    private string _claseInicio = "07:00";
    private string _claseFin = "08:00";
    private string? _loadError;
    private string? _msgGuardar;
    private string? _msgClase;
    private string _laboratorioNombre = "Laboratorio";
    private double _horasAcumuladasMensual;
    private string _rangoMesTexto = string.Empty;

    private int _anioSeleccionado = DateTime.Today.Year;
    private List<int> _yearsDisponibles = new();

    private List<HorarioEntry> _entradasDelDia =>
        _selectedDate.HasValue
            ? _horarios.Where(h => h.Fecha.Date == _selectedDate.Value.Date)
                .OrderBy(h => h.HoraInicio)
                .ToList()
            : new();

    private List<ClaseBlock> _bloquesClaseDelDia =>
        _selectedDate.HasValue
            ? _bloquesClase.Where(b => b.Fecha.Date == _selectedDate.Value.Date)
                .OrderBy(b => b.Inicio)
                .ToList()
            : new();

    private bool _puedeGuardarHorario =>
        _selectedDate.HasValue &&
        (_tipoSeleccionado == TipoPersona.Docente ? _docenteIdSeleccionado.HasValue : _becarioIdSeleccionado.HasValue);

    private bool _puedeGuardarClase =>
        _selectedDate.HasValue && _becarioIdSeleccionado.HasValue;

    private string? _selectedPersonaNombre => _tipoSeleccionado == TipoPersona.Docente
        ? (_docenteIdSeleccionado.HasValue ? $"Docente #{_docenteIdSeleccionado}" : null)
        : (_becarioIdSeleccionado.HasValue ? $"Becario #{_becarioIdSeleccionado}" : null);

    protected override async Task OnInitializedAsync()
    {
        _yearsDisponibles = Enumerable.Range(DateTime.Today.Year - 3, 7).ToList();
        _anioSeleccionado = _anchorDate.Year;

        await LoadPersonalAsync();
        await LoadLaboratorioNombreAsync();
        await LoadHorariosAsync();
    }

    private async Task LoadPersonalAsync()
    {
        try
        {
            _docentes = await LoadPersonasAsync("docentes", "docente_id");
            _becarios = await LoadPersonasAsync("becarios", "becario_id");
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    private async Task<List<PersonalItem>> LoadPersonasAsync(string tableName, string idColumn)
    {
        var items = new List<PersonalItem>();
        await using var conn = await DataSource.OpenConnectionAsync();
        var cmdText = $"SELECT {idColumn}, usuario_id FROM {tableName} ORDER BY {idColumn}";
        await using var cmd = new NpgsqlCommand(cmdText, conn);
        await using var reader = await cmd.ExecuteReaderAsync();

        while (await reader.ReadAsync())
        {
            items.Add(new PersonalItem(reader.GetInt32(0), reader.GetInt32(1)));
        }

        return items;
    }

    private async Task LoadLaboratorioNombreAsync()
    {
        await using var conn = await DataSource.OpenConnectionAsync();
        await using var cmd = new NpgsqlCommand("SELECT nombre FROM laboratorios WHERE laboratorio_id = @labId", conn);
        cmd.Parameters.AddWithValue("labId", LaboratorioState.LaboratorioId);
        var result = await cmd.ExecuteScalarAsync();
        _laboratorioNombre = result?.ToString() ?? $"Laboratorio #{LaboratorioState.LaboratorioId}";
    }

    private async Task LoadHorariosAsync()
    {
        _msgGuardar = null;
        _msgClase = null;
        _horarios.Clear();
        _bloquesClase.Clear();

        if (!HasPersonaSeleccionada())
        {
            return;
        }

        var (rangeStart, rangeEnd) = GetRangeForView();
        var (monthStart, monthEnd) = GetMonthRange(_anchorDate);
        _rangoMesTexto = $"{monthStart:dd/MM} - {monthEnd:dd/MM}";

        await using var conn = await DataSource.OpenConnectionAsync();

        if (_tipoSeleccionado == TipoPersona.Docente && _docenteIdSeleccionado.HasValue)
        {
            await using var cmd = new NpgsqlCommand(@"
                SELECT horario_docente_id, fecha, hora_inicio, hora_fin
                FROM horarios_docentes
                WHERE docente_id = @persona AND fecha BETWEEN @inicio AND @fin
                ORDER BY fecha, hora_inicio;", conn);
            cmd.Parameters.AddWithValue("persona", _docenteIdSeleccionado.Value);
            cmd.Parameters.AddWithValue("inicio", rangeStart);
            cmd.Parameters.AddWithValue("fin", rangeEnd);

            await using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                var fecha = reader.GetDateTime(1);
                var inicio = reader.GetTimeSpan(2);
                var fin = reader.GetTimeSpan(3);
                _horarios.Add(new HorarioEntry(reader.GetInt64(0), fecha, inicio, fin, (fin - inicio).TotalHours));
            }
        }
        else if (_becarioIdSeleccionado.HasValue)
        {
            await using var cmd = new NpgsqlCommand(@"
                SELECT horario_becario_id, fecha, hora_inicio, hora_fin
                FROM horarios_becarios
                WHERE becario_id = @persona AND fecha BETWEEN @inicio AND @fin
                ORDER BY fecha, hora_inicio;", conn);
            cmd.Parameters.AddWithValue("persona", _becarioIdSeleccionado.Value);
            cmd.Parameters.AddWithValue("inicio", rangeStart);
            cmd.Parameters.AddWithValue("fin", rangeEnd);

            await using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                var fecha = reader.GetDateTime(1);
                var inicio = reader.GetTimeSpan(2);
                var fin = reader.GetTimeSpan(3);
                _horarios.Add(new HorarioEntry(reader.GetInt64(0), fecha, inicio, fin, (fin - inicio).TotalHours));
            }

            await LoadBloquesClaseAsync(conn, rangeStart, rangeEnd);
        }

        await LoadHorasAcumuladasAsync(monthStart, monthEnd);
    }

    private async Task LoadBloquesClaseAsync(NpgsqlConnection conn, DateTime start, DateTime end)
    {
        if (!_becarioIdSeleccionado.HasValue)
        {
            return;
        }

        await using var cmd = new NpgsqlCommand(@"
            SELECT horario_clase_id, fecha, hora_inicio, hora_fin
            FROM horarios_clases_becario
            WHERE becario_id = @persona AND fecha BETWEEN @inicio AND @fin
            ORDER BY fecha, hora_inicio;", conn);
        cmd.Parameters.AddWithValue("persona", _becarioIdSeleccionado.Value);
        cmd.Parameters.AddWithValue("inicio", start);
        cmd.Parameters.AddWithValue("fin", end);

        await using var reader = await cmd.ExecuteReaderAsync();
        while (await reader.ReadAsync())
        {
            var fecha = reader.GetDateTime(1);
            var inicio = reader.GetTimeSpan(2);
            var fin = reader.GetTimeSpan(3);
            _bloquesClase.Add(new ClaseBlock(reader.GetInt64(0), fecha, inicio, fin));
        }
    }

    private async Task LoadHorasAcumuladasAsync(DateTime start, DateTime end)
    {
        if (!HasPersonaSeleccionada())
        {
            _horasAcumuladasMensual = 0;
            return;
        }

        await using var conn = await DataSource.OpenConnectionAsync();
        var tableName = _tipoSeleccionado == TipoPersona.Docente ? "horarios_docentes" : "horarios_becarios";
        var columnName = _tipoSeleccionado == TipoPersona.Docente ? "docente_id" : "becario_id";
        var personaId = _tipoSeleccionado == TipoPersona.Docente ? _docenteIdSeleccionado!.Value : _becarioIdSeleccionado!.Value;

        await using var cmd = new NpgsqlCommand($@"
            SELECT COALESCE(SUM(EXTRACT(EPOCH FROM (hora_fin - hora_inicio)) / 3600), 0)
            FROM {tableName}
            WHERE {columnName} = @persona AND fecha BETWEEN @inicio AND @fin;", conn);
        cmd.Parameters.AddWithValue("persona", personaId);
        cmd.Parameters.AddWithValue("inicio", start);
        cmd.Parameters.AddWithValue("fin", end);

        var result = await cmd.ExecuteScalarAsync();
        _horasAcumuladasMensual = Convert.ToDouble(result, CultureInfo.InvariantCulture);
    }

    private void OnTipoPersonaChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _tipoSeleccionado = value == "becario" ? TipoPersona.Becario : TipoPersona.Docente;
        _msgGuardar = null;
        _msgClase = null;
        _selectedDate = DateTime.Today;
        _ = LoadHorariosAsync();
    }

