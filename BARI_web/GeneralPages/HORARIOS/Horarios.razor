        display: block;
        margin-bottom: 0.4rem;
        color: #1f2937;
    }

    .radio-row {
        display: flex;
        gap: 1rem;
        font-weight: 600;
        color: #1f2937;
    }

    .accumulated {
        display: flex;
        align-items: baseline;
        gap: 0.35rem;
    }

    .accumulated-hours {
        font-size: 1.6rem;
        font-weight: 800;
        color: #0b2a68;
    }

    .accumulated-label {
        font-size: 0.85rem;
        color: #6b7280;
    }

    .calendar-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 1rem;
        align-items: center;
    }

    .calendar-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
    }

    .calendar-grid {
        margin-top: 1rem;
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 0.35rem;
    }

    .calendar-header-cell {
        text-align: center;
        font-weight: 700;
        font-size: 0.75rem;
        color: #6b7280;
    }

    .calendar-day {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 0.6rem;
        min-height: 64px;
        padding: 0.4rem;
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
        position: relative;
        cursor: pointer;
        transition: border 0.2s ease, background 0.2s ease;
    }

    .calendar-day:hover {
        border-color: #0b2a68;
        background: #f0f6ff;
    }

    .calendar-day.selected {
        border-color: #0b2a68;
        background: #e6efff;
        box-shadow: inset 0 0 0 1px #0b2a68;
    }

    .calendar-day.muted {
