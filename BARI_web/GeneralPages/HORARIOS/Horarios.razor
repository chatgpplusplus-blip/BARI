    private void OnDaySelected(DateTime date)
    {
        _selectedDate = date;
    }

    private void GoPrev()
    {
        _anchorDate = _viewModeSeleccionado switch
        {
            ViewMode.Semana => _anchorDate.AddDays(-7),
            ViewMode.Ano => _anchorDate.AddYears(-1),
            _ => _anchorDate.AddMonths(-1)
        };
        _anioSeleccionado = _anchorDate.Year;
        _ = LoadHorariosAsync();
    }

    private void GoNext()
    {
        _anchorDate = _viewModeSeleccionado switch
        {
            ViewMode.Semana => _anchorDate.AddDays(7),
            ViewMode.Ano => _anchorDate.AddYears(1),
            _ => _anchorDate.AddMonths(1)
        };
        _anioSeleccionado = _anchorDate.Year;
        _ = LoadHorariosAsync();
    }

    private void GoToday()
    {
        _anchorDate = DateTime.Today;
        _selectedDate = DateTime.Today;
        _anioSeleccionado = _anchorDate.Year;
        _ = LoadHorariosAsync();
    }

    private IEnumerable<DateTime> BuildMonthDays(DateTime reference)
    {
        var first = new DateTime(reference.Year, reference.Month, 1);
        var start = StartOfWeek(first);
        for (var i = 0; i < 42; i++)
        {
            yield return start.AddDays(i);
        }
    }

    private IEnumerable<DateTime> BuildWeekDays(DateTime reference)
    {
        var start = StartOfWeek(reference);
        return Enumerable.Range(0, 7).Select(i => start.AddDays(i));
    }

    private DateTime StartOfWeek(DateTime date)
    {
        var diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        return date.AddDays(-diff).Date;
    }

    private bool DayHasEntries(DateTime date) => _horarios.Any(h => h.Fecha.Date == date.Date);

    private (DateTime Start, DateTime End) GetRangeForView()
    {
        return _viewModeSeleccionado switch
        {
            ViewMode.Semana => (StartOfWeek(_anchorDate), StartOfWeek(_anchorDate).AddDays(6)),
            ViewMode.Ano => (new DateTime(_anchorDate.Year, 1, 1), new DateTime(_anchorDate.Year, 12, 31)),
            _ => GetMonthRange(_anchorDate)
        };
    }

    private (DateTime Start, DateTime End) GetMonthRange(DateTime reference)
    {
        var start = new DateTime(reference.Year, reference.Month, 1);
        var end = start.AddMonths(1).AddDays(-1);
        return (start, end);
    }

    private bool HasPersonaSeleccionada() => _tipoSeleccionado == TipoPersona.Docente
        ? _docenteIdSeleccionado.HasValue
        : _becarioIdSeleccionado.HasValue;

    private async Task SaveHorarioAsync()
    {
        _msgGuardar = null;

        if (!_selectedDate.HasValue || !HasPersonaSeleccionada())
        {
            _msgGuardar = "Selecciona un personal válido.";
            return;
        }

        if (!TimeSpan.TryParse(_horaEntrada, out var entrada) || !TimeSpan.TryParse(_horaSalida, out var salida))
        {
            _msgGuardar = "Horas inválidas.";
            return;
        }

        if (salida <= entrada)
        {
            _msgGuardar = "La hora de salida debe ser mayor a la de entrada.";
            return;
        }

        if (_tipoSeleccionado == TipoPersona.Becario && _bloquesClaseDelDia.Any(b => IntervalsOverlap(entrada, salida, b.Inicio, b.Fin)))
        {
            _msgGuardar = "Las horas se cruzan con un horario de clases.";
            return;
        }

        await using var conn = await DataSource.OpenConnectionAsync();
        if (_tipoSeleccionado == TipoPersona.Docente)
        {
            await using var cmd = new NpgsqlCommand(@"
                INSERT INTO horarios_docentes (docente_id, laboratorio_id, fecha, hora_inicio, hora_fin)
                VALUES (@persona, @lab, @fecha, @inicio, @fin);", conn);
            cmd.Parameters.AddWithValue("persona", _docenteIdSeleccionado!.Value);
            cmd.Parameters.AddWithValue("lab", LaboratorioState.LaboratorioId);
            cmd.Parameters.AddWithValue("fecha", _selectedDate.Value.Date);
            cmd.Parameters.AddWithValue("inicio", entrada);
            cmd.Parameters.AddWithValue("fin", salida);
            await cmd.ExecuteNonQueryAsync();
        }
        else
        {
            await using var cmd = new NpgsqlCommand(@"
                INSERT INTO horarios_becarios (becario_id, laboratorio_id, fecha, hora_inicio, hora_fin)
                VALUES (@persona, @lab, @fecha, @inicio, @fin);", conn);
            cmd.Parameters.AddWithValue("persona", _becarioIdSeleccionado!.Value);
            cmd.Parameters.AddWithValue("lab", LaboratorioState.LaboratorioId);
            cmd.Parameters.AddWithValue("fecha", _selectedDate.Value.Date);
            cmd.Parameters.AddWithValue("inicio", entrada);
            cmd.Parameters.AddWithValue("fin", salida);
            await cmd.ExecuteNonQueryAsync();
        }

        _msgGuardar = "Horario guardado.";
        await LoadHorariosAsync();
    }

    private async Task DeleteHorarioAsync(long horarioId)
    {
        var tableName = _tipoSeleccionado == TipoPersona.Docente ? "horarios_docentes" : "horarios_becarios";
        var idColumn = _tipoSeleccionado == TipoPersona.Docente ? "horario_docente_id" : "horario_becario_id";

        await using var conn = await DataSource.OpenConnectionAsync();
        await using var cmd = new NpgsqlCommand($"DELETE FROM {tableName} WHERE {idColumn} = @id", conn);
        cmd.Parameters.AddWithValue("id", horarioId);
        await cmd.ExecuteNonQueryAsync();

        await LoadHorariosAsync();
    }

    private async Task AddClaseAsync()
    {
        _msgClase = null;
        if (!_selectedDate.HasValue || !_becarioIdSeleccionado.HasValue)
        {
            _msgClase = "Selecciona un becario.";
            return;
        }

        if (!TimeSpan.TryParse(_claseInicio, out var inicio) || !TimeSpan.TryParse(_claseFin, out var fin))
        {
            _msgClase = "Horas inválidas.";
            return;
        }

        if (fin <= inicio)
        {
            _msgClase = "La hora fin debe ser mayor a la de inicio.";
            return;
        }

        await using var conn = await DataSource.OpenConnectionAsync();
        await using var cmd = new NpgsqlCommand(@"
            INSERT INTO horarios_clases_becario (becario_id, fecha, hora_inicio, hora_fin)
            VALUES (@persona, @fecha, @inicio, @fin);", conn);
        cmd.Parameters.AddWithValue("persona", _becarioIdSeleccionado.Value);
        cmd.Parameters.AddWithValue("fecha", _selectedDate.Value.Date);
        cmd.Parameters.AddWithValue("inicio", inicio);
        cmd.Parameters.AddWithValue("fin", fin);
        await cmd.ExecuteNonQueryAsync();

        _msgClase = "Bloqueo agregado.";
        await LoadHorariosAsync();
    }

    private async Task DeleteClaseAsync(long bloqueId)
    {
        await using var conn = await DataSource.OpenConnectionAsync();
        await using var cmd = new NpgsqlCommand("DELETE FROM horarios_clases_becario WHERE horario_clase_id = @id", conn);
        cmd.Parameters.AddWithValue("id", bloqueId);
        await cmd.ExecuteNonQueryAsync();

        await LoadHorariosAsync();
    }

    private bool IntervalsOverlap(TimeSpan aStart, TimeSpan aEnd, TimeSpan bStart, TimeSpan bEnd)
        => aStart < bEnd && bStart < aEnd;
}
