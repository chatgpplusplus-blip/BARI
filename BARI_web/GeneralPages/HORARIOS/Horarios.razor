@page "/horarios"
@using System.Globalization

<PageTitle>Horarios</PageTitle>


<div class="h-wrap">
    <div class="h-hero">
        <div>
            <div class="h-title">Horarios</div>
            <div class="h-sub">Arrastra en el horario del día para registrar, y edita moviendo/estirando bloques.</div>
        </div>
        <div class="h-pill">
            Lab: <strong>@_laboratorioNombre</strong>
        </div>
    </div>

    <div class="h-topcard">
        <LaboratorioSelector />

        <div class="h-toprow">
            <!-- IZQ: Tipo -->
            <div class="h-slot left">
                <div class="h-chip">
                    <span>Tipo</span>
                    <label class="h-radio">
                        <input type="radio" name="tipoPersonal" value="docente"
                               checked="@(_tipoSeleccionado == TipoPersona.Docente)"
                               @onchange="OnTipoPersonaChanged" />
                        Docente
                    </label>
                    <label class="h-radio">
                        <input type="radio" name="tipoPersonal" value="becario"
                               checked="@(_tipoSeleccionado == TipoPersona.Becario)"
                               @onchange="OnTipoPersonaChanged" />
                        Becario
                    </label>
                </div>
            </div>

            <!-- CENTRO: Persona -->
            <div class="h-slot center">
                <div class="h-chip h-persona">
                    <span>Persona</span>
                    @if (_tipoSeleccionado == TipoPersona.Docente)
                    {
                        <select class="h-select" @onchange="OnDocenteChanged">
                            <option value="">Docente...</option>
                            @foreach (var d in _docentes)
                            {
                                <option value="@d.Id" selected="@(_docenteIdSeleccionado == d.Id)">@d.Nombre</option>
                            }
                        </select>
                    }
                    else
                    {
                        <select class="h-select" @onchange="OnBecarioChanged">
                            <option value="">Becario...</option>
                            @foreach (var b in _becarios)
                            {
                                <option value="@b.Id" selected="@(_becarioIdSeleccionado == b.Id)">@b.Nombre</option>
                            }
                        </select>
                    }
                </div>
            </div>

            <!-- DER: Acumulado -->
            <div class="h-slot right">
                <div class="h-chip h-hours">
                    <span>Acumulado del mes</span>
                    <div class="h-big">@_horasAcumuladasMensual.ToString("0.00", CultureInfo.InvariantCulture)h</div>
                    <div class="h-muted">@_rangoMesTexto</div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="h-error">Error: @_loadError</div>
    }

    <div class="h-grid">
        <!-- CALENDARIO -->
        <div class="h-card">
            <div class="h-cardhead">
                <div>
                    <div class="h-cardtitle">Calendario</div>
                    <div class="h-muted">@(_selectedPersonaNombre ?? "Sin selección")</div>
                </div>

                <div class="h-calctrl">
                    <button class="h-btn" type="button" @onclick="GoPrev">←</button>
                    <div class="h-month">@MesAnchorTexto</div>
                    <button class="h-btn" type="button" @onclick="GoToday">Hoy</button>
                    <button class="h-btn" type="button" @onclick="GoNext">→</button>
                </div>

            </div>

            <div class="h-cal">
                @foreach (var dayName in _dayHeaders)
                {
                    <div class="h-cal-h">@dayName</div>
                }

                @foreach (var day in BuildMonthDays(_anchorDate))
                {
                    var isCurrentMonth = day.Month == _anchorDate.Month;
                    var worked = GetWorkedHours(day.Date);

                    <button class="h-day @(day.Date == _selectedDate?.Date ? "sel" : "") @(isCurrentMonth ? "" : "mut")"
                            type="button"
                            @onclick="() => OnDaySelected(day.Date)">
                        <span class="n">@day.Day</span>
                        @if (worked > 0)
                        {
                            <span class="b">@worked.ToString("0.#", CultureInfo.InvariantCulture)h</span>
                        }
                    </button>
                }
            </div>
        </div>

        <!-- SCHEDULE DEL DÍA -->
        <div class="h-card">
            @if (_selectedDate.HasValue)
            {
                <ScheduleDay Date="_selectedDate.Value"
                             Subtitle="@(_tipoSeleccionado == TipoPersona.Docente ? "Docente · Bloques por tipo" : "Becario · Colores por estado")"
                             Items="_scheduleItemsDelDia"
                             WorkTypes="_workTypes"
                             ShowStatus="@(_tipoSeleccionado == TipoPersona.Becario)"
                             Disabled="@(!HasPersona())"
                             DisabledMessage="Selecciona un docente/becario para poder crear o editar horarios."
                             OnSave="SaveScheduleItemAsync"
                             OnDelete="DeleteScheduleItemAsync" />

            }
            else
            {
                <div class="h-muted" style="padding:16px;">Selecciona un día.</div>
            }
        </div>
    </div>
</div>
