@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JS

<div class="sd-card">
    <div class="sd-head">
        <div class="sd-title">
            <div class="sd-date">@Date.ToString("dddd, dd 'de' MMMM", new CultureInfo("es-ES"))</div>
            <div class="sd-sub">@Subtitle</div>
        </div>

        <div class="sd-actions">
            <button class="sd-btn primary" type="button" @onclick="QuickAdd" disabled="@Disabled">+</button>
        </div>

    </div>

    <div class="sd-body">
        <div class="sd-grid">
            <div class="sd-hours">
                @for (var h = StartHour; h <= EndHour; h++)
                {
                    <div class="sd-hour">@($"{h:00}:00")</div>
                }
            </div>

            <div class="sd-surface"
                 style="@($"height:{MinuteToPx(EndMinute - StartMinute)}px")"
                 @ref="_surfaceRef"
                 @onpointerdown="SurfacePointerDown"
                 @onpointermove="SurfacePointerMove"
                 @onpointerup="SurfacePointerUp"
                 @onpointercancel="SurfacePointerUp">
                @if (Disabled)
                {
                    <div class="sd-overlay">
                        <div class="sd-overlay-card">@DisabledMessage</div>
                    </div>
                }

                @for (var h = StartHour; h <= EndHour; h++)
                {
                    <div class="sd-line" style="@($"top:{MinuteToPx((h - StartHour) * 60)}px")"></div>
                }

                @foreach (var item in Items.OrderBy(i => i.StartMinute))
                {
                    var top = MinuteToPx(item.StartMinute - StartMinute);
                    var height = MinuteToPx(item.EndMinute - item.StartMinute);

                    <div class="sd-block @item.CssClass @(item == _selected ? "selected" : "")"
                         style="@($"top:{top}px; height:{height}px;")"
                         @onpointerdown:stopPropagation="true"
                         @onclick:stopPropagation="true"
                         @onpointerdown="async (e) => await BlockPointerDown(e, item)"
                         @onclick="() => Select(item)">
                        <div class="sd-block-title">
                            <span>@item.Label</span>
                            <span class="sd-block-time">@MinutesToTime(item.StartMinute)–@MinutesToTime(item.EndMinute)</span>
                        </div>

                        <!-- Handles: stopPropagation evita iniciar selección del fondo -->
                        <div class="sd-handle top"
                             @onpointerdown:stopPropagation="true"
                             @onpointerdown="async (e) => await ResizePointerDown(e, item, true)"></div>

                        <div class="sd-handle bot"
                             @onpointerdown:stopPropagation="true"
                             @onpointerdown="async (e) => await ResizePointerDown(e, item, false)"></div>
                    </div>
                }

                @if (_isSelecting)
                {
                    var gTop = Math.Min(_selStartPx, _selEndPx);
                    var gHeight = Math.Abs(_selEndPx - _selStartPx);

                    <div class="sd-ghost" style="@($"top:{gTop}px; height:{gHeight}px;")">
                        <span>Nuevo</span>
                    </div>
                }
            </div>
        </div>

        <div class="sd-side @(_drawerOpen ? "open" : "")">
            <div class="sd-side-head">
                <div class="sd-side-title">Editar bloque</div>
                <button class="sd-x" type="button" @onclick="CloseDrawer">✕</button>
            </div>

            @if (_selected is not null)
            {
                <div class="sd-form">
                    <div class="sd-field">
                        <label>Inicio</label>
                        <input type="time" class="sd-input" step="60"
                               value="@MinutesToTime(_selected.StartMinute)"
                               @onchange="(e) => OnTimeChange(e, true)" />
                    </div>

                    <div class="sd-field">
                        <label>Fin</label>
                        <input type="time" class="sd-input" step="60"
                               value="@MinutesToTime(_selected.EndMinute)"
                               @onchange="(e) => OnTimeChange(e, false)" />
                    </div>

                    @if (WorkTypes?.Length > 0 && _selected.Editable)
                    {
                        <div class="sd-field full">
                            <label>Tipo</label>
                            <select class="sd-input" @onchange="OnTypeChange">
                                @foreach (var t in WorkTypes)
                                {
                                    <option value="@t" selected="@(_selected.Type == t)">@t</option>
                                }
                            </select>
                        </div>
                    }

                    @if (ShowStatus && _selected.Editable)
                    {
                        <div class="sd-field full">
                            <label>Estado</label>
                            <select class="sd-input" @onchange="OnStatusChange">
                                @foreach (var st in Statuses)
                                {
                                    <option value="@st" selected="@(_selected.Status == st)">@st</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="sd-field full">
                        <label>Observaciones</label>
                        <textarea class="sd-input" rows="3" @bind="_selected.Notes"></textarea>
                    </div>

                    <div class="sd-side-actions">
                        @if (_selected.Editable)
                        {
                            <button class="sd-btn danger" type="button" @onclick="DeleteSelected">Eliminar</button>
                            <button class="sd-btn primary" type="button" @onclick="SaveSelected">Guardar</button>
                        }
                        else
                        {
                            <div class="sd-muted">Este bloque no es editable.</div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="sd-empty">Selecciona o crea un bloque arrastrando.</div>
                <div class="sd-form">
                    <div class="sd-field">
                        <label>Inicio</label>
                        <input type="time" class="sd-input" step="60"
                               value="@MinutesToTime(_draftStartMinute)"
                               @onchange="(e) => OnDraftTimeChange(e, true)" />
                    </div>

                    <div class="sd-field">
                        <label>Fin</label>
                        <input type="time" class="sd-input" step="60"
                               value="@MinutesToTime(_draftEndMinute)"
                               @onchange="(e) => OnDraftTimeChange(e, false)" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_draftError))
                    {
                        <div class="sd-muted">@_draftError</div>
                    }

                    <div class="sd-side-actions">
                        <button class="sd-btn primary" type="button" @onclick="CreateFromDraft" disabled="@Disabled">Crear</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // =========================
    // Parameters
    // =========================
    [Parameter] public DateTime Date { get; set; }
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public List<ScheduleItemVm> Items { get; set; } = new();

    [Parameter] public string[] WorkTypes { get; set; } = Array.Empty<string>();
    [Parameter] public bool ShowStatus { get; set; }

    [Parameter] public Func<ScheduleItemVm, Task<ScheduleItemVm>> OnSave { get; set; } = default!;
    [Parameter] public Func<ScheduleItemVm, Task> OnDelete { get; set; } = default!;

    public string[] Statuses { get; } = new[] { "pendiente", "validado", "rechazado" };

    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string DisabledMessage { get; set; } = "Selecciona una persona para crear o editar bloques.";


    // =========================
    // Config
    // =========================
    public int StartHour { get; set; } = 6;
    public int EndHour { get; set; } = 22;

    private int StartMinute => StartHour * 60;
    private int EndMinute => EndHour * 60;

    private ElementReference _surfaceRef;

    // Surface rect (px)
    private double _rectTop;
    private double _rectHeight;

    // Selection (ghost)
    private bool _isSelecting;
    private double _selStartPx;
    private double _selEndPx;

    // Drawer + selection
    private ScheduleItemVm? _selected;
    private bool _drawerOpen;
    private int _draftStartMinute;
    private int _draftEndMinute;
    private string? _draftError;
    private bool _draftInitialized;

    // Drag/resize state
    private bool _dragging;
    private bool _resizing;
    private bool _resizeTop;

    private int _dragStartMinute;
    private int _origStart;
    private int _origEnd;

    public sealed class ScheduleItemVm
    {
        public long Id { get; set; }          // 0 => nuevo
        public DateTime Date { get; set; }
        public int StartMinute { get; set; }  // minutos del día
        public int EndMinute { get; set; }
        public string Type { get; set; } = "laboratorio";
        public string Status { get; set; } = "pendiente";
        public string Notes { get; set; } = "";
        public bool Editable { get; set; } = true;

        public string Label { get; set; } = "Trabajo";
        public string CssClass { get; set; } = "work-lab";
    }

    // =========================
    // Math helpers
    // =========================
    private const double PxPerMinute = 1.2; // 60min = 72px

    private double MinuteToPx(int minutes) => minutes * PxPerMinute;
    private int PxToMinute(double px) => (int)Math.Round(px / PxPerMinute);

    private string MinutesToTime(int m) => $"{m / 60:00}:{m % 60:00}";

    private string? _interopError;

    protected override void OnParametersSet()
    {
        if (!_draftInitialized || _draftStartMinute < StartMinute || _draftEndMinute > EndMinute)
        {
            _draftStartMinute = StartMinute;
            _draftEndMinute = Math.Min(StartMinute + 60, EndMinute);
            _draftInitialized = true;
            _draftError = null;
        }
    }

    private async Task<bool> EnsureRectAsync()
    {
        try
        {
            var rect = await JS.InvokeAsync<Rect>("scheduleInterop.getRect", _surfaceRef);
            if (rect is null) return false;

            _rectTop = rect.top;
            _rectHeight = rect.height <= 0 ? 1 : rect.height;
            _interopError = null;
            return true;
        }
        catch (Microsoft.JSInterop.JSException ex)
        {
            _interopError = ex.Message;
            return false;
        }
    }


    private int Snap(int minute, int step) =>
        (int)Math.Round(minute / (double)step) * step;

    private int ClientYToMinute(double clientY)
    {
        var y = clientY - _rectTop;
        y = Math.Clamp(y, 0, _rectHeight);

        var totalMinutes = EndMinute - StartMinute;
        var minute = StartMinute + (int)Math.Round((y / _rectHeight) * totalMinutes);

        minute = Snap(minute, 15);
        return Math.Clamp(minute, StartMinute, EndMinute);
    }

    // =========================
    // Surface interactions
    // =========================
    private async Task SurfacePointerDown(PointerEventArgs e)
    {
        if (Disabled) return;

        if (!await EnsureRectAsync()) return;

        // si estamos arrastrando por algún motivo, ignorar
        if (_dragging || _resizing) return;

        _isSelecting = true;
        var m = ClientYToMinute(e.ClientY);
        _selStartPx = MinuteToPx(m - StartMinute);
        _selEndPx = _selStartPx;

        _selected = null;
        _drawerOpen = false;
        StateHasChanged();
    }

    private async Task SurfacePointerMove(PointerEventArgs e)
    {
        if (Disabled) return;

        if (_dragging || _resizing)
        {
            DragOrResizeMove(e);
            await Task.CompletedTask;
            return;
        }

        if (!_isSelecting) return;

        var m = ClientYToMinute(e.ClientY);
        _selEndPx = MinuteToPx(m - StartMinute);
        StateHasChanged();

        await Task.CompletedTask;
    }

    private async Task SurfacePointerUp(PointerEventArgs e)
    {
        if (Disabled) return;

        // fin drag/resize
        if (_dragging || _resizing)
        {
            _dragging = false;
            _resizing = false;
            await Task.CompletedTask;
            return;
        }

        // fin selección
        if (!_isSelecting) return;
        _isSelecting = false;

        var a = PxToMinute(_selStartPx) + StartMinute;
        var b = PxToMinute(_selEndPx) + StartMinute;

        var start = Math.Min(a, b);
        var end = Math.Max(a, b);

        // mínimo 15 min
        if (end - start < 15)
        {
            StateHasChanged();
            return;
        }

        var item = new ScheduleItemVm
            {
                Id = 0,
                Date = Date.Date,
                StartMinute = start,
                EndMinute = end,
                Editable = true
            };

        item.Type = WorkTypes.Length > 0 ? WorkTypes[0] : "trabajo";
        ApplyStyle(item);

        Items.Add(item);
        Select(item);
        _drawerOpen = true;
        StateHasChanged();

        await Task.CompletedTask;
    }

    // =========================
    // Block interactions
    // =========================
    private void Select(ScheduleItemVm item)
    {
        _selected = item;
        _drawerOpen = true;
        StateHasChanged();
    }

    private async Task BlockPointerDown(PointerEventArgs e, ScheduleItemVm item)
    {
        if (Disabled) return;

        if (!item.Editable)
        {
            Select(item);
            return;
        }

        if (!await EnsureRectAsync()) return;

        _selected = item;
        _drawerOpen = true;

        _dragging = true;
        _resizing = false;

        _dragStartMinute = ClientYToMinute(e.ClientY);
        _origStart = item.StartMinute;
        _origEnd = item.EndMinute;

        StateHasChanged();
    }

    private async Task ResizePointerDown(PointerEventArgs e, ScheduleItemVm item, bool top)
    {
        if (Disabled) return;

        if (!item.Editable)
        {
            Select(item);
            return;
        }

        if (!await EnsureRectAsync()) return;

        _selected = item;
        _drawerOpen = true;

        _resizing = true;
        _dragging = false;
        _resizeTop = top;

        _dragStartMinute = ClientYToMinute(e.ClientY);
        _origStart = item.StartMinute;
        _origEnd = item.EndMinute;

        StateHasChanged();
    }

    private void DragOrResizeMove(PointerEventArgs e)
    {
        if (_selected is null) return;

        var m = ClientYToMinute(e.ClientY);
        var delta = m - _dragStartMinute;

        if (_dragging)
        {
            var dur = _origEnd - _origStart;
            var ns = Math.Clamp(_origStart + delta, StartMinute, EndMinute - dur);
            _selected.StartMinute = ns;
            _selected.EndMinute = ns + dur;
        }
        else if (_resizing)
        {
            if (_resizeTop)
            {
                var ns = Math.Clamp(_origStart + delta, StartMinute, _selected.EndMinute - 15);
                _selected.StartMinute = ns;
            }
            else
            {
                var ne = Math.Clamp(_origEnd + delta, _selected.StartMinute + 15, EndMinute);
                _selected.EndMinute = ne;
            }
        }

        StateHasChanged();
    }

    // =========================
    // Drawer actions
    // =========================
    private void CloseDrawer()
    {
        _drawerOpen = false;
        _selected = null;
        StateHasChanged();
    }

    private async Task SaveSelected()
    {
        if (_selected is null) return;
        if (!_selected.Editable) return;
        if (_selected.EndMinute <= _selected.StartMinute + 14) return;

        ApplyStyle(_selected);

        // Guardar en backend (insert/update)
        var saved = await OnSave(_selected);
        _selected.Id = saved.Id;

        StateHasChanged();
    }

    private async Task DeleteSelected()
    {
        if (_selected is null) return;
        if (!_selected.Editable) return;

        var item = _selected;

        Items.Remove(item);
        _selected = null;
        _drawerOpen = false;

        if (item.Id != 0)
            await OnDelete(item);

        StateHasChanged();
    }
    private int SnapCeil(int minute, int step) => ((minute + step - 1) / step) * step;

    private static bool Overlap(int a1, int a2, int b1, int b2) => a1 < b2 && b1 < a2;

    private bool IsFree(int start, int end, ScheduleItemVm? ignore = null)
    {
        foreach (var it in Items)
        {
            if (ignore is not null && ReferenceEquals(it, ignore)) continue;
            if (Overlap(start, end, it.StartMinute, it.EndMinute)) return false;
        }
        return true;
    }

    private void QuickAdd()
    {
        const int step = 15;

        // Duración por defecto: 60min (si no hay hueco, intenta 30 y 15)
        int[] durations = { 60, 30, 15 };

        int from = StartMinute;

        if (Date.Date == DateTime.Today)
        {
            var now = DateTime.Now;
            var nowMin = now.Hour * 60 + now.Minute;
            from = Math.Max(StartMinute, SnapCeil(nowMin, step));
        }

        from = Math.Clamp(from, StartMinute, EndMinute);

        foreach (var dur in durations)
        {
            var lastStart = EndMinute - dur;
            for (var s = from; s <= lastStart; s += step)
            {
                var e = s + dur;
                if (IsFree(s, e))
                {
                    var item = new ScheduleItemVm
                        {
                            Id = 0,
                            Date = Date.Date,
                            StartMinute = s,
                            EndMinute = e,
                            Editable = true
                        };

                    item.Type = WorkTypes.Length > 0 ? WorkTypes[0] : "trabajo";
                    ApplyStyle(item);

                    Items.Add(item);
                    Select(item);
                    _drawerOpen = true;
                    return;
                }
            }
        }

        // Si no hay hueco: no hace nada (o puedes mostrar mensaje)
    }

    private void OnTypeChange(ChangeEventArgs e)
    {
        if (_selected is null) return;
        _selected.Type = e.Value?.ToString() ?? _selected.Type;
        ApplyStyle(_selected);
    }

    private void OnStatusChange(ChangeEventArgs e)
    {
        if (_selected is null) return;
        _selected.Status = e.Value?.ToString() ?? _selected.Status;
        ApplyStyle(_selected);
    }

    private void OnTimeChange(ChangeEventArgs e, bool start)
    {
        if (_selected is null) return;
        if (!_selected.Editable) return;

        if (TimeSpan.TryParse(e.Value?.ToString(), out var ts))
        {
            var m = Snap((int)ts.TotalMinutes, 15);
            m = Math.Clamp(m, StartMinute, EndMinute);

            if (start)
                _selected.StartMinute = Math.Min(m, _selected.EndMinute - 15);
            else
                _selected.EndMinute = Math.Max(m, _selected.StartMinute + 15);

            StateHasChanged();
        }
    }

    private void OnDraftTimeChange(ChangeEventArgs e, bool start)
    {
        if (TimeSpan.TryParse(e.Value?.ToString(), out var ts))
        {
            var m = Snap((int)ts.TotalMinutes, 15);
            m = Math.Clamp(m, StartMinute, EndMinute);

            if (start)
            {
                _draftStartMinute = Math.Min(m, _draftEndMinute - 15);
            }
            else
            {
                _draftEndMinute = Math.Max(m, _draftStartMinute + 15);
            }

            _draftError = null;
            StateHasChanged();
        }
    }

    private void CreateFromDraft()
    {
        if (Disabled) return;

        var start = Math.Clamp(_draftStartMinute, StartMinute, EndMinute);
        var end = Math.Clamp(_draftEndMinute, StartMinute, EndMinute);

        if (end - start < 15)
        {
            _draftError = "El bloque debe durar al menos 15 minutos.";
            return;
        }

        if (!IsFree(start, end))
        {
            _draftError = "El horario se cruza con otro bloque.";
            return;
        }

        var item = new ScheduleItemVm
            {
                Id = 0,
                Date = Date.Date,
                StartMinute = start,
                EndMinute = end,
                Editable = true
            };

        item.Type = WorkTypes.Length > 0 ? WorkTypes[0] : "trabajo";
        ApplyStyle(item);

        Items.Add(item);
        Select(item);
        _drawerOpen = true;
        _draftError = null;
    }

    private void ApplyStyle(ScheduleItemVm item)
    {
        // Docente: colores por tipo
        if (WorkTypes.Length > 0)
        {
            item.Label = item.Type;
            item.CssClass = item.Type switch
            {
                "laboratorio" => "work-lab",
                "clase" => "work-class",
                _ => "work-other"
            };
            return;
        }

        // Becario: colores por estado
        item.Label = "trabajo";
        item.CssClass = item.Status switch
        {
            "validado" => "st-ok",
            "rechazado" => "st-bad",
            _ => "st-pend"
        };
    }

    private sealed class Rect
    {
        public double top { get; set; }
        public double height { get; set; }
    }
}
