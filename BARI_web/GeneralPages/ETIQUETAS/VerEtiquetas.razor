    private async Task LoadEtiquetaAsync()
    {
        ResetAll();
        if (string.IsNullOrWhiteSpace(_selectedContenedorId)) return;

        try
        {
            await using var conn = await DataSource.OpenConnectionAsync();

            // ✅ Quitado imagen_url (ya no se usa)
            const string sql = @"
SELECT s.sustancia_id,
       c.cont_id,
       COALESCE(NULLIF(s.nombre_comercial, ''), NULLIF(s.nombre_quimico, ''), s.sustancia_id) AS nombre,
       NULLIF(s.nombre_comercial, '') AS nombre_comercial,
       NULLIF(s.nombre_quimico, '') AS nombre_quimico,
       NULLIF(s.cas, '') AS cas,
       NULLIF(s.forma_fisica, '') AS forma_fisica,
       NULLIF(s.palabra_advertencia, '') AS palabra_advertencia,
       NULLIF(s.concentracion, '') AS concentracion,
       NULLIF(s.pureza, '') AS pureza,
       NULLIF(s.descripcion, '') AS descripcion,
       NULLIF(s.observaciones, '') AS observaciones,
       cat.nombre AS categoria,
       string_agg(DISTINCT (cat.nombre || ' · ' || sc.nombre), ', ' ORDER BY (cat.nombre || ' · ' || sc.nombre)) AS subcategorias,
       COALESCE(s.sustancia_controlada, false) AS controlada,
       NULLIF(c.qr, '') AS qr,
       c.fecha_compra,
       c.fecha_recepcion,
       c.fecha_apertura,
       c.fecha_vencimiento,
       c.cantidad_reactivo_nominal,
       c.cantidad_reactivo_actual,
       u.simbolo AS unidad,
       NULLIF(c.proveedor, '') AS proveedor,
       NULLIF(c.proveedor_direccion, '') AS proveedor_direccion,
       NULLIF(c.proveedor_telefono_emergencia, '') AS proveedor_telefono_emergencia,
       cond.nombre AS condicion,
       ma.nombre AS marca_nombre,
       ma.imagen_url AS marca_logo
FROM sustancias s
INNER JOIN contenedores c ON c.sustancia_id = s.sustancia_id
LEFT JOIN categorias cat ON cat.categoria_id = s.categoria_id
LEFT JOIN sustancias_subcategorias ssc ON ssc.sustancia_id = s.sustancia_id
LEFT JOIN subcategorias sc ON sc.subcategoria_id = ssc.subcategoria_id AND sc.categoria_id = s.categoria_id
LEFT JOIN unidades u ON u.unidad_id = c.unidad_id
LEFT JOIN condiciones cond ON cond.condicion_id = c.condicion_id
LEFT JOIN marcas ma ON ma.marca_id = c.marca_id
WHERE c.cont_id = @cont
  AND c.laboratorio_id = @lab
  AND s.categoria_id = @cat
GROUP BY s.sustancia_id, c.cont_id, s.nombre_comercial, s.nombre_quimico, s.cas,
         s.forma_fisica, s.palabra_advertencia, s.concentracion, s.pureza, s.descripcion, s.observaciones,
         cat.nombre, s.sustancia_controlada, c.qr, c.fecha_compra,
         c.fecha_recepcion, c.fecha_apertura, c.fecha_vencimiento,
         c.cantidad_reactivo_nominal, c.cantidad_reactivo_actual, u.simbolo,
         c.proveedor, c.proveedor_direccion, c.proveedor_telefono_emergencia, cond.nombre, ma.nombre, ma.imagen_url
LIMIT 1;
";
            await using var cmd = new NpgsqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("cont", _selectedContenedorId);
            cmd.Parameters.AddWithValue("lab", LaboratorioState.LaboratorioId);
            cmd.Parameters.AddWithValue("cat", CategoriaReactivoId);

            await using var reader = await cmd.ExecuteReaderAsync();
            if (await reader.ReadAsync())
            {
                _etiqueta = new EtiquetaReactivo(
                    reader.GetString(0),
                    reader.GetString(2),
                    reader.IsDBNull(3) ? null : reader.GetString(3),
                    reader.IsDBNull(4) ? null : reader.GetString(4),
                    reader.IsDBNull(5) ? null : reader.GetString(5),
                    reader.IsDBNull(6) ? null : reader.GetString(6),
                    reader.IsDBNull(7) ? null : reader.GetString(7),
                    reader.IsDBNull(8) ? null : reader.GetString(8),
                    reader.IsDBNull(9) ? null : reader.GetString(9),
                    reader.IsDBNull(10) ? null : reader.GetString(10),
                    reader.IsDBNull(11) ? null : reader.GetString(11),
                    reader.IsDBNull(12) ? null : reader.GetString(12),
                    reader.IsDBNull(13) ? null : reader.GetString(13),
                    !reader.IsDBNull(14) && reader.GetBoolean(14)
                );

                _qrTexto = reader.IsDBNull(15) ? null : reader.GetString(15);
                _fechaCompra = reader.IsDBNull(16) ? null : reader.GetDateTime(16);
                _fechaRecepcion = reader.IsDBNull(17) ? null : reader.GetDateTime(17);
                _fechaApertura = reader.IsDBNull(18) ? null : reader.GetDateTime(18);
                _fechaVencimiento = reader.IsDBNull(19) ? null : reader.GetDateTime(19);

                _contCantidadNominal = reader.IsDBNull(20) ? null : reader.GetDecimal(20);
                _contCantidadActual = reader.IsDBNull(21) ? null : reader.GetDecimal(21);

                _contUnidad = reader.IsDBNull(22) ? null : reader.GetString(22);
                _contProveedor = reader.IsDBNull(23) ? null : reader.GetString(23);
                _contProveedorDireccion = reader.IsDBNull(24) ? null : reader.GetString(24);
                _contProveedorTelefono = reader.IsDBNull(25) ? null : reader.GetString(25);
                _contCondicion = reader.IsDBNull(26) ? null : reader.GetString(26);

                _marcaNombre = reader.IsDBNull(27) ? null : reader.GetString(27);
                _marcaLogoUrl = reader.IsDBNull(28) ? null : reader.GetString(28);
            }
            else
            {
                _loadError = "No se encontró el contenedor.";
                return;
            }

            await reader.CloseAsync();

            const string sqlGhs = @"
SELECT g.icon_url
FROM sustancias_pictogramas sp
INNER JOIN ghs_pictogramas g ON g.ghs_id = sp.ghs_id
WHERE sp.sustancia_id = @id
ORDER BY sp.ghs_id;
";
            await using var cmdGhs = new NpgsqlCommand(sqlGhs, conn);
            cmdGhs.Parameters.AddWithValue("id", _etiqueta.Id);
            await using var readerGhs = await cmdGhs.ExecuteReaderAsync();
            while (await readerGhs.ReadAsync())
                if (!readerGhs.IsDBNull(0)) _ghsIconUrls.Add(readerGhs.GetString(0));
            await readerGhs.CloseAsync();

            const string sqlRombo = @"
SELECT r.seccion, COALESCE(r.numero::text, r.codigo)
FROM sustancia_rombo sr
INNER JOIN rombo r ON r.rombo_id = sr.rombo_id
WHERE sr.sustancia_id = @id;
";
            await using var cmdRombo = new NpgsqlCommand(sqlRombo, conn);
            cmdRombo.Parameters.AddWithValue("id", _etiqueta.Id);
            await using var readerRombo = await cmdRombo.ExecuteReaderAsync();
            while (await readerRombo.ReadAsync())
            {
                var seccion = readerRombo.GetString(0);
                var valor = readerRombo.IsDBNull(1) ? null : readerRombo.GetString(1);
                switch (seccion)
                {
                    case "SALUD": _romboSalud = valor; break;
                    case "INFLAMABILIDAD": _romboInflamabilidad = valor; break;
                    case "REACTIVIDAD": _romboReactividad = valor; break;
                    case "ESPECIAL": _romboEspecial = valor; break;
                }
            }
            await readerRombo.CloseAsync();

            const string sqlStock = @"
SELECT SUM(COALESCE(c.cantidad_reactivo_actual, c.cantidad_reactivo_nominal)) AS total,
       CASE WHEN COUNT(DISTINCT c.unidad_id) = 1 THEN MAX(u.simbolo) ELSE NULL END AS unidad
FROM contenedores c
LEFT JOIN unidades u ON u.unidad_id = c.unidad_id
WHERE c.sustancia_id = @id
  AND c.laboratorio_id = @lab;
";
            await using var cmdStock = new NpgsqlCommand(sqlStock, conn);
            cmdStock.Parameters.AddWithValue("id", _etiqueta.Id);
            cmdStock.Parameters.AddWithValue("lab", LaboratorioState.LaboratorioId);
            await using var readerStock = await cmdStock.ExecuteReaderAsync();
            if (await readerStock.ReadAsync())
            {
                _stockTotal = readerStock.IsDBNull(0) ? null : readerStock.GetDecimal(0);
                _stockUnidad = readerStock.IsDBNull(1) ? null : readerStock.GetString(1);
            }
            await readerStock.CloseAsync();

            _qrImageUrl = string.IsNullOrWhiteSpace(_qrTexto)
                ? null
                : $"https://api.qrserver.com/v1/create-qr-code/?size=260x260&data={Uri.EscapeDataString(_qrTexto)}";

            const string sqlHpCodes = @"
SELECT
    string_agg(DISTINCT h.h_id, ', ' ORDER BY h.h_id) AS h_codes,
    string_agg(DISTINCT p.p_id, ', ' ORDER BY p.p_id) AS p_codes
FROM sustancias s
LEFT JOIN sustancias_h sh ON sh.sustancia_id = s.sustancia_id
LEFT JOIN h_codes h ON h.h_id = sh.h_id
LEFT JOIN sustancias_p sp ON sp.sustancia_id = s.sustancia_id
LEFT JOIN p_codes p ON p.p_id = sp.p_id
WHERE s.sustancia_id = @id
GROUP BY s.sustancia_id;
";
            await using var cmdHp = new NpgsqlCommand(sqlHpCodes, conn);
            cmdHp.Parameters.AddWithValue("id", _etiqueta.Id);
            await using var readerHp = await cmdHp.ExecuteReaderAsync();
            if (await readerHp.ReadAsync())
            {
                _hCodesText = readerHp.IsDBNull(0) ? null : readerHp.GetString(0);
                _pCodesText = readerHp.IsDBNull(1) ? null : readerHp.GetString(1);
            }
            await readerHp.CloseAsync();

            const string sqlHpDescriptions = @"
SELECT 'H' AS tipo, h.h_id, h.descripcion
FROM sustancias_h sh
INNER JOIN h_codes h ON h.h_id = sh.h_id
WHERE sh.sustancia_id = @id
UNION ALL
SELECT 'P' AS tipo, p.p_id, p.descripcion
FROM sustancias_p sp
INNER JOIN p_codes p ON p.p_id = sp.p_id
WHERE sp.sustancia_id = @id
ORDER BY tipo, 2;
";
            await using var cmdHpDetails = new NpgsqlCommand(sqlHpDescriptions, conn);
            cmdHpDetails.Parameters.AddWithValue("id", _etiqueta.Id);
            await using var readerHpDetails = await cmdHpDetails.ExecuteReaderAsync();
            while (await readerHpDetails.ReadAsync())
            {
                var tipo = readerHpDetails.GetString(0);
                var code = readerHpDetails.IsDBNull(1) ? "" : readerHpDetails.GetString(1);
                var desc = readerHpDetails.IsDBNull(2) ? "" : readerHpDetails.GetString(2);
                var line = string.IsNullOrWhiteSpace(desc) ? code : $"{code}: {desc}";
                if (tipo == "H")
                {
                    _hDescriptions.Add(line);
                }
                else
                {
                    _pDescriptions.Add(line);
                }
            }

            HydrateEditableFields();

            // pedir fit
            MarkFit();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    private string CardLayoutClass
    {
        get
        {
            var ratio = (_labelHeightMm <= 0) ? Aspect : _labelWidthMm / (double)_labelHeightMm;

            if (ratio <= 1.20) return "layout-square";  // 1:1 o más alto
            if (ratio <= 1.60) return "layout-mid";     // intermedio
            return "layout-wide";                       // 2:1 típico
        }
    }


