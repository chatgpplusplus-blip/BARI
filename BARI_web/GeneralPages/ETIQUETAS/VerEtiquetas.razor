    // ✅ Canvas px dinámico para permitir reflow/reordenamiento según ratio real
    private string LabelInnerStyle
    {
        get
        {
            var ratio = (_labelHeightMm <= 0) ? Aspect : (_labelWidthMm / (double)_labelHeightMm);
            if (ratio <= 0.1) ratio = Aspect;

            // ✅ (opcional) cambiar el “canvas base” para que en cuadrado el scale suba (se vea más grande)
            var designW = ratio <= 1.20 ? 720.0 : (ratio <= 1.60 ? 820.0 : 900.0);
            var designH = designW / ratio;

            // ✅ anchos/tamaños que cambian según forma
            var rightW = ratio <= 1.20 ? 260 : (ratio <= 1.60 ? 285 : 300);
            var qr = ratio <= 1.20 ? 140 : 120;
            var pad = ratio <= 1.20 ? 18 : 14;

            return
                $"--design-w:{designW:0}px; --design-h:{designH:0}px;" +
                $"--right-w:{rightW}px; --qr:{qr}px; --pad:{pad}px;";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadContenedoresLookupAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(ContenedorId) && ContenedorId != _selectedContenedorId)
        {
            _selectedContenedorId = ContenedorId;
            await LoadEtiquetaAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_etiqueta is null) return;

        // Modo completo: desactivar observadores (evita trabajo innecesario)
        if (_previewFull)
        {
            if (_fitObserversActive)
            {
                try { await JS.InvokeVoidAsync("labelFit.unobserve", _fitFrameRef); } catch { }
                _fitObserversActive = false;
            }
            return;
        }

        // Modo fit: activar observadores una vez
        if (!_fitObserversActive)
        {
            try
            {
                await JS.InvokeVoidAsync("labelFit.observe", _fitFrameRef, _fitInnerRef);
                _fitObserversActive = true;
                _fitPending = false;
            }
            catch
            {
                // si el JS aún no está listo, reintenta en el siguiente render
                _fitPending = true;
            }
            return;
        }

        // Refit explícito (cuando editas campos desde Blazor)
        if (_fitPending)
        {
            _fitPending = false;
            try
            {
                await JS.InvokeVoidAsync("labelFit.refit", _fitFrameRef, _fitInnerRef);
            }
            catch
            {
                _fitPending = true;
            }
        }
    }

    private void MarkFit()
    {
        if (_previewFull) return;
        _fitPending = true;
        InvokeAsync(StateHasChanged);
    }

    private void SetPreviewMode(bool full)
    {
        _previewFull = full;
        // al volver a fit, queremos recalcular sí o sí
        if (!_previewFull) _fitPending = true;
        InvokeAsync(StateHasChanged);
    }

    private void OnLockRatioChanged(ChangeEventArgs e)
    {
        _lockAspectRatio = (e.Value is bool b && b);
        if (_lockAspectRatio)
            _labelHeightMm = Math.Max(20, (int)Math.Round(_labelWidthMm / Aspect));
        MarkFit();
    }

    private void OnWidthInput(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var w)) return;
        w = Math.Clamp(w, 20, 1000);
        _labelWidthMm = w;

        if (_lockAspectRatio)
            _labelHeightMm = Math.Max(20, (int)Math.Round(_labelWidthMm / Aspect));

        MarkFit();
    }

    private void OnHeightInput(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var h)) return;
        h = Math.Clamp(h, 20, 600);
        _labelHeightMm = h;
        MarkFit();
    }

    private void OnAnyImageLoaded() => MarkFit();

    private async Task LoadContenedoresLookupAsync()
    {
        _contenedoresLookup.Clear();

        await using var conn = await DataSource.OpenConnectionAsync();
        const string sql = @"
SELECT c.cont_id,
       COALESCE(NULLIF(s.nombre_comercial, ''), NULLIF(s.nombre_quimico, ''), s.sustancia_id) AS nombre
FROM contenedores c
INNER JOIN sustancias s ON s.sustancia_id = c.sustancia_id
WHERE c.laboratorio_id = @lab
  AND s.categoria_id = @cat
ORDER BY nombre, c.cont_id;
";
        await using var cmd = new NpgsqlCommand(sql, conn);
        cmd.Parameters.AddWithValue("lab", LaboratorioState.LaboratorioId);
        cmd.Parameters.AddWithValue("cat", CategoriaReactivoId);

        await using var reader = await cmd.ExecuteReaderAsync();
        while (await reader.ReadAsync())
        {
            var contId = reader.GetString(0);
            var nombre = reader.GetString(1);
            _contenedoresLookup.Add(new ContenedorLookup(contId, $"{nombre} - {contId}"));
        }
    }

