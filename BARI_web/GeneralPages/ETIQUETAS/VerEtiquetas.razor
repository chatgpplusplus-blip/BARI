@page "/ver-etiquetas"
@page "/ver-etiquetas/contenedor/{ContenedorId}"

@using Npgsql
@using System
@using System.Globalization
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@inject NpgsqlDataSource DataSource
@inject LaboratorioState LaboratorioState
@inject NavigationManager Nav

<PageTitle>Etiquetado de Reactivos</PageTitle>

<section class="page-card">
    <h2>Etiquetado de Reactivos</h2>
    <p>
        Visualizador inspirado en etiquetas de Merck. Selecciona un contenedor para ver y ajustar el diseño
        antes de imprimir. Puedes modificar campos, dimensiones e importar una imagen.
    </p>
</section>

<section class="page-card" style="margin-top:1.5rem;">
    <div class="label-controls">
        <div class="label-control">
            <label class="text-xs text-gray-500">Contenedor</label>
            <select class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_selectedContenedorId) ? "is-filled" : "")"
                    @onchange="OnContenedorChanged">
                <option value="">Del desplegable seleccione un contenedor para ver o editar</option>
                @foreach (var c in _contenedoresLookup)
                {
                    <option value="@c.Id" selected="@(c.Id == _selectedContenedorId)">@c.Label</option>
                }
            </select>
        </div>

        <div class="label-control">
            <label class="text-xs text-gray-500">Ancho (mm)</label>
            <input class="border p-1 form-control @(_labelWidthMm > 0 ? "is-filled" : "")"
                   type="number"
                   min="20"
                   @bind-value="_labelWidthMm"
                   @bind-value:event="oninput" />
        </div>

        <div class="label-control">
            <label class="text-xs text-gray-500">Alto (mm)</label>
            <input class="border p-1 form-control @(_labelHeightMm > 0 ? "is-filled" : "")"
                   type="number"
                   min="20"
                   @bind-value="_labelHeightMm"
                   @bind-value:event="oninput" />
        </div>

        <div class="label-control">
            <label class="text-xs text-gray-500">Imagen de etiqueta</label>
            <div class="inline-radio">
                <label class="toggle @(_labelImagenModo == "url" ? "is-filled" : "")">
                    <input type="radio" name="imagen-etiqueta" value="url" checked="@(_labelImagenModo == "url")"
                           @onchange="@(() => _labelImagenModo = "url")" />
                    <span>URL</span>
                </label>
                <label class="toggle @(_labelImagenModo == "archivo" ? "is-filled" : "")">
                    <input type="radio" name="imagen-etiqueta" value="archivo" checked="@(_labelImagenModo == "archivo")"
                           @onchange="@(() => _labelImagenModo = "archivo")" />
                    <span>Archivo</span>
                </label>
            </div>

            @if (_labelImagenModo == "url")
            {
                <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_labelImagenUrl) ? "is-filled" : "")"
                       placeholder="URL de imagen"
                       @bind="_labelImagenUrl" />
            }
            else
            {
                <label class="upload-drop">
                    <InputFile OnChange="OnEtiquetaImagenSeleccionada" accept="image/png,image/jpeg,image/jpg,image/webp" />
                    <span>Arrastra una imagen o haz clic para buscar</span>
                </label>
                @if (!string.IsNullOrWhiteSpace(_labelImagenArchivoNombre))
                {
                    <div class="text-xs text-gray-500">Archivo: @_labelImagenArchivoNombre</div>
                }
            }
        </div>
    </div>
</section>

@if (string.IsNullOrWhiteSpace(_selectedContenedorId))
{
    <section class="page-card" style="margin-top:1.5rem;">
        <div class="empty">
            <div class="helper">Del desplegable seleccione un contenedor para ver o editar.</div>
        </div>
    </section>
}
else if (_loadError is not null)
{
    <section class="page-card" style="margin-top:1.5rem;">
        <p class="error-note">No se pudo cargar el contenedor: @_loadError</p>
    </section>
}
else if (_etiqueta is not null)
{
    <section class="page-card" style="margin-top:1.5rem;">
        <div class="label-layout">
            <div class="label-edit">
                <h4>Campos editables</h4>
                <div class="label-edit-section">
                    <div class="label-edit-title">Reactivo</div>
                    <div class="label-edit-grid">
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">Nombre principal</label>
                            <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editNombrePrincipal) ? "is-filled" : "")"
                                   @bind="_editNombrePrincipal" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">Nombre químico</label>
                            <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editNombreQuimico) ? "is-filled" : "")"
                                   @bind="_editNombreQuimico" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">CAS</label>
                            <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editCas) ? "is-filled" : "")"
                                   @bind="_editCas" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">Forma física</label>
                            <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editFormaFisica) ? "is-filled" : "")"
                                   @bind="_editFormaFisica" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">Categoría</label>
                            <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editCategoria) ? "is-filled" : "")"
                                   @bind="_editCategoria" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">Subcategorías</label>
                            <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editSubcategorias) ? "is-filled" : "")"
                                   @bind="_editSubcategorias" />
                        </div>
                        <div class="label-edit-field label-edit-wide">
                            <label class="text-xs text-gray-500">Descripción</label>
                            <textarea class="border p-1 form-control"
                                      rows="3"
                                      @bind="_editDescripcion"></textarea>
                        </div>
                        <div class="label-edit-field label-edit-wide">
                            <label class="text-xs text-gray-500">Observaciones</label>
                            <textarea class="border p-1 form-control"
                                      rows="3"
                                      @bind="_editObservaciones"></textarea>
                        </div>
                    </div>
                </div>

                <div class="label-edit-section">
                    <div class="label-edit-title">Contenedor</div>
                    <div class="label-edit-grid">
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">ID contenedor</label>
                            <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editContenedorId) ? "is-filled" : "")"
                                   @bind="_editContenedorId" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">QR</label>
                            <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editQrText) ? "is-filled" : "")"
                                   @bind="EditQrText"
                                   @bind:event="oninput" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">Cantidad nominal</label>
                            <InputNumber class="border p-1 form-control @(_editContCantidadNominal.HasValue ? "is-filled" : "")"
                                         @bind-Value="_editContCantidadNominal" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">Cantidad actual</label>
                            <InputNumber class="border p-1 form-control @(_editContCantidadActual.HasValue ? "is-filled" : "")"
                                         @bind-Value="_editContCantidadActual" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">Unidad</label>
                            <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editContUnidad) ? "is-filled" : "")"
                                   @bind="_editContUnidad" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">Proveedor</label>
                            <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editContProveedor) ? "is-filled" : "")"
                                   @bind="_editContProveedor" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">Condición</label>
                            <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editContCondicion) ? "is-filled" : "")"
                                   @bind="_editContCondicion" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">Fecha adquisición</label>
                            <InputDate class="border p-1 form-control @(_editFechaCompra.HasValue ? "is-filled" : "")"
                                       @bind-Value="_editFechaCompra" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">Fecha recepción</label>
                            <InputDate class="border p-1 form-control @(_editFechaRecepcion.HasValue ? "is-filled" : "")"
                                       @bind-Value="_editFechaRecepcion" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">Fecha apertura</label>
                            <InputDate class="border p-1 form-control @(_editFechaApertura.HasValue ? "is-filled" : "")"
                                       @bind-Value="_editFechaApertura" />
                        </div>
                        <div class="label-edit-field">
                            <label class="text-xs text-gray-500">Fecha vencimiento</label>
                            <InputDate class="border p-1 form-control @(_editFechaVencimiento.HasValue ? "is-filled" : "")"
                                       @bind-Value="_editFechaVencimiento" />
                        </div>
                    </div>
                </div>
                <p class="text-xs text-gray-500" style="margin-top:.75rem;">
                    Los cambios solo afectan el visualizador (no se guardan en la base de datos).
                </p>
            </div>

            <div class="label-preview">
                <h4>Vista previa de etiqueta</h4>
                <div class="label-card" style="width:@($"{_labelWidthMm}mm"); height:@($"{_labelHeightMm}mm");">
                    <div class="label-brand">
                        <div class="label-brand-left">
                            <img src="@UpsaLogoUrl" alt="Logo UPSA" />
                            <div>
                                <div class="label-org">UPSA · Inventario</div>
                                <div class="label-brand-name">@(_marcaNombre ?? "Marca: —")</div>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_marcaLogoUrl))
                        {
                            <div class="label-brand-logo">
                                <img src="@_marcaLogoUrl" alt="Logo de marca" />
                            </div>
                        }
                    </div>

                    <div class="label-main">
                        <div class="label-title">@_editNombrePrincipal</div>
                        <div class="label-sub">@_editNombreQuimico</div>
                    </div>

                    <div class="label-details">
                        <div class="label-pair">
                            <span class="label-key">CAS</span>
                            <span>@(_editCas ?? "—")</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">Forma</span>
                            <span>@(_editFormaFisica ?? "—")</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">Cantidad total</span>
                            <span>@GetStockDisplay()</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">Cantidad nominal</span>
                            <span>@FormatCantidad(_editContCantidadNominal, _editContUnidad)</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">Cantidad actual</span>
                            <span>@FormatCantidad(_editContCantidadActual, _editContUnidad)</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">QR</span>
                            <span>@GetQrShortLabel()</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">Contenedor</span>
                            <span>@(_editContenedorId ?? "—")</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">Categoría</span>
                            <span>@(_editCategoria ?? "—")</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">Subcategorías</span>
                            <span>@(_editSubcategorias ?? "—")</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">Adquisición</span>
                            <span>@FormatDate(_editFechaCompra)</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">Recepción</span>
                            <span>@FormatDate(_editFechaRecepcion)</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">Apertura</span>
                            <span>@FormatDate(_editFechaApertura)</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">Vencimiento</span>
                            <span>@FormatDate(_editFechaVencimiento)</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">Proveedor</span>
                            <span>@(_editContProveedor ?? "—")</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">Condición</span>
                            <span>@(_editContCondicion ?? "—")</span>
                        </div>
                    </div>

                    <div class="label-safety">
                        <div class="label-pair">
                            <span class="label-key">H codes</span>
                            <span>@(string.IsNullOrWhiteSpace(_hCodesText) ? "—" : _hCodesText)</span>
                        </div>
                        <div class="label-pair">
                            <span class="label-key">P codes</span>
                            <span>@(string.IsNullOrWhiteSpace(_pCodesText) ? "—" : _pCodesText)</span>
                        </div>
                    </div>

                    <div class="label-side">
                        <div class="label-media">
                            @if (_ghsIconUrls.Count > 0)
                            {
                                foreach (var icon in _ghsIconUrls.Take(3))
                                {
                                    <img src="@icon" alt="GHS" />
                                }
                            }
                            else
                            {
                                <span class="text-xs text-gray-500">Sin pictogramas</span>
                            }
                        </div>

                        <div class="label-rombo">
                            <div class="rombo-diamond">
                                <div class="rombo-cell rombo-salud">S @(_romboSalud ?? "—")</div>
                                <div class="rombo-cell rombo-inflam">I @(_romboInflamabilidad ?? "—")</div>
                                <div class="rombo-cell rombo-react">R @(_romboReactividad ?? "—")</div>
                                <div class="rombo-cell rombo-especial">E @(_romboEspecial ?? "—")</div>
                            </div>
                            <div class="text-xs text-gray-500">Rombo NFPA</div>
                        </div>

                        <div class="label-qr">
                            @if (!string.IsNullOrWhiteSpace(_qrImageUrl))
                            {
                                <img src="@_qrImageUrl" alt="QR etiqueta" />
                            }
                            else
                            {
                                <span class="text-xs text-gray-500">Sin QR</span>
                            }
                        </div>
                        <div class="label-photo">
                            @if (!string.IsNullOrWhiteSpace(_labelImagenFinal))
                            {
                                <img src="@_labelImagenFinal" alt="Imagen etiqueta" />
                            }
                        </div>
                    </div>

                    <div class="label-notes">
                        <div class="label-note-section">
                            <div class="label-note-title">Descripción</div>
                            <div>@_editDescripcion</div>
                        </div>
                        <div class="label-note-section">
                            <div class="label-note-title">Observaciones</div>
                            <div>@_editObservaciones</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public string? ContenedorId { get; set; }

    private const string CategoriaReactivoId = "reactivo-quimico";
    private const string UpsaLogoUrl = "https://vc4a.com/wp-content/uploads/2022/06/198068246_2916680591924255_5728041621538232491_n.jpg";

    private readonly List<ContenedorLookup> _contenedoresLookup = new();
    private readonly List<string> _ghsIconUrls = new();

    private string? _selectedContenedorId;
    private string? _loadError;
    private EtiquetaReactivo? _etiqueta;

    private int _labelWidthMm = 90;
    private int _labelHeightMm = 50;
    private string _labelImagenModo = "url";
    private string? _labelImagenUrl;
    private string? _labelImagenDataUrl;
    private string? _labelImagenArchivoNombre;

    private string? _editNombrePrincipal;
    private string? _editNombreQuimico;
    private string? _editCas;
    private string? _editFormaFisica;
    private string? _editCategoria;
    private string? _editSubcategorias;
    private string? _editDescripcion;
    private string? _editObservaciones;
    private string? _editContenedorId;
    private string? _editQrText;
    private decimal? _editContCantidadNominal;
    private decimal? _editContCantidadActual;
    private string? _editContUnidad;
    private string? _editContProveedor;
    private string? _editContCondicion;
    private DateTime? _editFechaCompra;
    private DateTime? _editFechaRecepcion;
    private DateTime? _editFechaApertura;
    private DateTime? _editFechaVencimiento;
    private string? _romboSalud;
    private string? _romboInflamabilidad;
    private string? _romboReactividad;
    private string? _romboEspecial;
    private decimal? _stockTotal;
    private string? _stockUnidad;
    private string? _qrTexto;
    private string? _qrImageUrl;
    private string? _hCodesText;
    private string? _pCodesText;
    private string? _marcaNombre;
    private string? _marcaLogoUrl;
    private DateTime? _fechaCompra;
    private DateTime? _fechaRecepcion;
    private DateTime? _fechaApertura;
    private DateTime? _fechaVencimiento;
    private decimal? _contCantidadNominal;
    private decimal? _contCantidadActual;
    private string? _contUnidad;
    private string? _contProveedor;
    private string? _contCondicion;

    private string? _labelImagenFinal =>
        _labelImagenModo == "url" ? _labelImagenUrl : _labelImagenDataUrl;

    protected override async Task OnInitializedAsync()
    {
        await LoadContenedoresLookupAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(ContenedorId) && ContenedorId != _selectedContenedorId)
        {
            _selectedContenedorId = ContenedorId;
            await LoadEtiquetaAsync();
        }
    }

    private async Task LoadContenedoresLookupAsync()
    {
        _contenedoresLookup.Clear();

        await using var conn = await DataSource.OpenConnectionAsync();
        const string sql = @"
SELECT c.cont_id,
       COALESCE(NULLIF(s.nombre_comercial, ''), NULLIF(s.nombre_quimico, ''), s.sustancia_id) AS nombre
FROM contenedores c
INNER JOIN sustancias s ON s.sustancia_id = c.sustancia_id
WHERE c.laboratorio_id = @lab
  AND s.categoria_id = @cat
ORDER BY nombre, c.cont_id;
";
        await using var cmd = new NpgsqlCommand(sql, conn);
        cmd.Parameters.AddWithValue("lab", LaboratorioState.LaboratorioId);
        cmd.Parameters.AddWithValue("cat", CategoriaReactivoId);

        await using var reader = await cmd.ExecuteReaderAsync();
        while (await reader.ReadAsync())
        {
            var contId = reader.GetString(0);
            var nombre = reader.GetString(1);
            _contenedoresLookup.Add(new ContenedorLookup(
                contId,
                $"{nombre} - {contId}"
            ));
        }
    }

    private async Task OnContenedorChanged(ChangeEventArgs args)
    {
        _selectedContenedorId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(_selectedContenedorId))
        {
            _etiqueta = null;
            _ghsIconUrls.Clear();
            _loadError = null;
            _stockTotal = null;
            _stockUnidad = null;
            _qrTexto = null;
            _qrImageUrl = null;
            _hCodesText = null;
            _pCodesText = null;
            _marcaNombre = null;
            _marcaLogoUrl = null;
            _fechaCompra = null;
            _fechaRecepcion = null;
            _fechaApertura = null;
            _fechaVencimiento = null;
            _contCantidadNominal = null;
            _contCantidadActual = null;
            _contUnidad = null;
            _contProveedor = null;
            _contCondicion = null;
            _editContenedorId = null;
            _editQrText = null;
            _editContCantidadNominal = null;
            _editContCantidadActual = null;
            _editContUnidad = null;
            _editContProveedor = null;
            _editContCondicion = null;
            _editFechaCompra = null;
            _editFechaRecepcion = null;
            _editFechaApertura = null;
            _editFechaVencimiento = null;
            return;
        }

        Nav.NavigateTo($"/ver-etiquetas/contenedor/{_selectedContenedorId}");
        await LoadEtiquetaAsync();
    }

    private async Task LoadEtiquetaAsync()
    {
        _loadError = null;
        _etiqueta = null;
        _ghsIconUrls.Clear();
        _romboSalud = null;
        _romboInflamabilidad = null;
        _romboReactividad = null;
        _romboEspecial = null;
        _stockTotal = null;
        _stockUnidad = null;
        _qrTexto = null;
        _qrImageUrl = null;
        _hCodesText = null;
        _pCodesText = null;
        _marcaNombre = null;
        _marcaLogoUrl = null;
        _fechaCompra = null;
        _fechaRecepcion = null;
        _fechaApertura = null;
        _fechaVencimiento = null;
        _contCantidadNominal = null;
        _contCantidadActual = null;
        _contUnidad = null;
        _contProveedor = null;
        _contCondicion = null;
        _editContenedorId = null;
        _editQrText = null;
        _editContCantidadNominal = null;
        _editContCantidadActual = null;
        _editContUnidad = null;
        _editContProveedor = null;
        _editContCondicion = null;
        _editFechaCompra = null;
        _editFechaRecepcion = null;
        _editFechaApertura = null;
        _editFechaVencimiento = null;

        if (string.IsNullOrWhiteSpace(_selectedContenedorId))
            return;

        try
        {
            await using var conn = await DataSource.OpenConnectionAsync();
            const string sql = @"
SELECT s.sustancia_id,
       c.cont_id,
       COALESCE(NULLIF(s.nombre_comercial, ''), NULLIF(s.nombre_quimico, ''), s.sustancia_id) AS nombre,
       s.nombre_comercial,
       s.nombre_quimico,
       s.cas,
       s.forma_fisica,
       s.descripcion,
       s.observaciones,
       s.imagen_url,
       COALESCE(cat.nombre, '') AS categoria,
       COALESCE(string_agg(DISTINCT (cat.nombre || ' · ' || sc.nombre), ', ' ORDER BY (cat.nombre || ' · ' || sc.nombre)), '') AS subcategorias,
       COALESCE(s.sustancia_controlada, false) AS controlada,
       c.qr,
       c.fecha_compra,
       c.fecha_recepcion,
       c.fecha_apertura,
       c.fecha_vencimiento,
       c.cantidad_reactivo_nominal,
       c.cantidad_reactivo_actual,
       COALESCE(u.simbolo, '') AS unidad,
       COALESCE(c.proveedor, '') AS proveedor,
       COALESCE(cond.nombre, '') AS condicion,
       COALESCE(ma.nombre, '') AS marca_nombre,
       ma.imagen_url AS marca_logo
FROM sustancias s
INNER JOIN contenedores c ON c.sustancia_id = s.sustancia_id
LEFT JOIN categorias cat ON cat.categoria_id = s.categoria_id
LEFT JOIN sustancias_subcategorias ssc ON ssc.sustancia_id = s.sustancia_id
LEFT JOIN subcategorias sc ON sc.subcategoria_id = ssc.subcategoria_id AND sc.categoria_id = s.categoria_id
LEFT JOIN unidades u ON u.unidad_id = c.unidad_id
LEFT JOIN condiciones cond ON cond.condicion_id = c.condicion_id
LEFT JOIN marcas ma ON ma.marca_id = c.marca_id
WHERE c.cont_id = @cont
  AND c.laboratorio_id = @lab
  AND s.categoria_id = @cat
GROUP BY s.sustancia_id, c.cont_id, s.nombre_comercial, s.nombre_quimico, s.cas,
         s.forma_fisica, s.descripcion, s.observaciones, s.imagen_url,
         cat.nombre, s.sustancia_controlada, c.qr, c.fecha_compra,
         c.fecha_recepcion, c.fecha_apertura, c.fecha_vencimiento,
         c.cantidad_reactivo_nominal, c.cantidad_reactivo_actual, u.simbolo,
         c.proveedor, cond.nombre, ma.nombre, ma.imagen_url
LIMIT 1;
";
            await using var cmd = new NpgsqlCommand(sql, conn);
            cmd.Parameters.AddWithValue("cont", _selectedContenedorId);
            cmd.Parameters.AddWithValue("lab", LaboratorioState.LaboratorioId);
            cmd.Parameters.AddWithValue("cat", CategoriaReactivoId);

            await using var reader = await cmd.ExecuteReaderAsync();
            if (await reader.ReadAsync())
            {
                _etiqueta = new EtiquetaReactivo(
                    reader.GetString(0),
                    reader.GetString(2),
                    reader.IsDBNull(3) ? null : reader.GetString(3),
                    reader.IsDBNull(4) ? null : reader.GetString(4),
                    reader.IsDBNull(5) ? null : reader.GetString(5),
                    reader.IsDBNull(6) ? null : reader.GetString(6),
                    reader.IsDBNull(7) ? null : reader.GetString(7),
                    reader.IsDBNull(8) ? null : reader.GetString(8),
                    reader.IsDBNull(9) ? null : reader.GetString(9),
                    reader.IsDBNull(10) ? null : reader.GetString(10),
                    reader.IsDBNull(11) ? null : reader.GetString(11),
                    !reader.IsDBNull(12) && reader.GetBoolean(12)
                );

                _qrTexto = reader.IsDBNull(13) ? null : reader.GetString(13);
                _fechaCompra = reader.IsDBNull(14) ? null : reader.GetDateTime(14);
                _fechaRecepcion = reader.IsDBNull(15) ? null : reader.GetDateTime(15);
                _fechaApertura = reader.IsDBNull(16) ? null : reader.GetDateTime(16);
                _fechaVencimiento = reader.IsDBNull(17) ? null : reader.GetDateTime(17);
                _contCantidadNominal = reader.IsDBNull(18) ? null : reader.GetDecimal(18);
                _contCantidadActual = reader.IsDBNull(19) ? null : reader.GetDecimal(19);
                _contUnidad = reader.IsDBNull(20) ? null : reader.GetString(20);
                _contProveedor = reader.IsDBNull(21) ? null : reader.GetString(21);
                _contCondicion = reader.IsDBNull(22) ? null : reader.GetString(22);
                _marcaNombre = reader.IsDBNull(23) ? null : reader.GetString(23);
                _marcaLogoUrl = reader.IsDBNull(24) ? null : reader.GetString(24);
            }
            else
            {
                _loadError = "No se encontró el contenedor.";
                return;
            }

            await reader.CloseAsync();

            const string sqlGhs = @"
SELECT g.icon_url
FROM sustancias_pictogramas sp
INNER JOIN ghs_pictogramas g ON g.ghs_id = sp.ghs_id
WHERE sp.sustancia_id = @id
ORDER BY sp.ghs_id;
";
            await using var cmdGhs = new NpgsqlCommand(sqlGhs, conn);
            cmdGhs.Parameters.AddWithValue("id", _etiqueta.Id);
            await using var readerGhs = await cmdGhs.ExecuteReaderAsync();
            while (await readerGhs.ReadAsync())
            {
                if (!readerGhs.IsDBNull(0))
                {
                    _ghsIconUrls.Add(readerGhs.GetString(0));
                }
            }

            await readerGhs.CloseAsync();

            const string sqlRombo = @"
SELECT r.seccion, COALESCE(r.numero::text, r.codigo)
FROM sustancia_rombo sr
INNER JOIN rombo r ON r.rombo_id = sr.rombo_id
WHERE sr.sustancia_id = @id;
";
            await using var cmdRombo = new NpgsqlCommand(sqlRombo, conn);
            cmdRombo.Parameters.AddWithValue("id", _etiqueta.Id);
            await using var readerRombo = await cmdRombo.ExecuteReaderAsync();
            while (await readerRombo.ReadAsync())
            {
                var seccion = readerRombo.GetString(0);
                var valor = readerRombo.IsDBNull(1) ? null : readerRombo.GetString(1);
                switch (seccion)
                {
                    case "SALUD":
                        _romboSalud = valor;
                        break;
                    case "INFLAMABILIDAD":
                        _romboInflamabilidad = valor;
                        break;
                    case "REACTIVIDAD":
                        _romboReactividad = valor;
                        break;
                    case "ESPECIAL":
                        _romboEspecial = valor;
                        break;
                }
            }

            await readerRombo.CloseAsync();

            const string sqlStock = @"
SELECT SUM(COALESCE(c.cantidad_reactivo_actual, c.cantidad_reactivo_nominal)) AS total,
       CASE WHEN COUNT(DISTINCT c.unidad_id) = 1 THEN MAX(u.simbolo) ELSE '' END AS unidad
FROM contenedores c
LEFT JOIN unidades u ON u.unidad_id = c.unidad_id
WHERE c.sustancia_id = @id
  AND c.laboratorio_id = @lab;
";
            await using var cmdStock = new NpgsqlCommand(sqlStock, conn);
            cmdStock.Parameters.AddWithValue("id", _etiqueta.Id);
            cmdStock.Parameters.AddWithValue("lab", LaboratorioState.LaboratorioId);
            await using var readerStock = await cmdStock.ExecuteReaderAsync();
            if (await readerStock.ReadAsync())
            {
                _stockTotal = readerStock.IsDBNull(0) ? null : readerStock.GetDecimal(0);
                _stockUnidad = readerStock.IsDBNull(1) ? null : readerStock.GetString(1);
            }

            await readerStock.CloseAsync();

            _qrImageUrl = string.IsNullOrWhiteSpace(_qrTexto)
                ? null
                : $"https://api.qrserver.com/v1/create-qr-code/?size=120x120&data={Uri.EscapeDataString(_qrTexto)}";

            const string sqlHpCodes = @"
SELECT
    COALESCE(string_agg(DISTINCT h.h_id, ', ' ORDER BY h.h_id), '') AS h_codes,
    COALESCE(string_agg(DISTINCT p.p_id, ', ' ORDER BY p.p_id), '') AS p_codes
FROM sustancias s
LEFT JOIN sustancias_h sh ON sh.sustancia_id = s.sustancia_id
LEFT JOIN h_codes h ON h.h_id = sh.h_id
LEFT JOIN sustancias_p sp ON sp.sustancia_id = s.sustancia_id
LEFT JOIN p_codes p ON p.p_id = sp.p_id
WHERE s.sustancia_id = @id;
";
            await using var cmdHp = new NpgsqlCommand(sqlHpCodes, conn);
            cmdHp.Parameters.AddWithValue("id", _etiqueta.Id);
            await using var readerHp = await cmdHp.ExecuteReaderAsync();
            if (await readerHp.ReadAsync())
            {
                _hCodesText = readerHp.IsDBNull(0) ? null : readerHp.GetString(0);
                _pCodesText = readerHp.IsDBNull(1) ? null : readerHp.GetString(1);
            }

            HydrateEditableFields();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    private void HydrateEditableFields()
    {
        if (_etiqueta is null)
            return;

        _editNombrePrincipal = _etiqueta.Nombre;
        _editNombreQuimico = string.IsNullOrWhiteSpace(_etiqueta.NombreQuimico) ? _etiqueta.NombreComercial : _etiqueta.NombreQuimico;
        _editCas = _etiqueta.Cas;
        _editFormaFisica = _etiqueta.FormaFisica;
        _editCategoria = _etiqueta.Categoria;
        _editSubcategorias = _etiqueta.Subcategorias;
        _editDescripcion = _etiqueta.Descripcion;
        _editObservaciones = _etiqueta.Observaciones;
        _labelImagenUrl = _etiqueta.ImagenUrl;
        _labelImagenDataUrl = null;
        _labelImagenArchivoNombre = null;
        _editContenedorId = _selectedContenedorId;
        _editQrText = _qrTexto;
        _editContCantidadNominal = _contCantidadNominal;
        _editContCantidadActual = _contCantidadActual;
        _editContUnidad = _contUnidad;
        _editContProveedor = _contProveedor;
        _editContCondicion = _contCondicion;
        _editFechaCompra = _fechaCompra;
        _editFechaRecepcion = _fechaRecepcion;
        _editFechaApertura = _fechaApertura;
        _editFechaVencimiento = _fechaVencimiento;
    }

    private string GetStockDisplay()
    {
        if (!_stockTotal.HasValue)
        {
            return "—";
        }

        var cantidad = _stockTotal.Value.ToString("0.##", CultureInfo.CurrentCulture);
        return string.IsNullOrWhiteSpace(_stockUnidad) ? cantidad : $"{cantidad} {_stockUnidad}".Trim();
    }

    private string GetQrShortLabel()
    {
        if (string.IsNullOrWhiteSpace(_editQrText))
        {
            return "QR: —";
        }

        var texto = _editQrText.Length > 18 ? $"{_editQrText[..18]}…" : _editQrText;
        return $"QR: {texto}";
    }

    private static string FormatCantidad(decimal? cantidad, string? unidad)
    {
        if (!cantidad.HasValue)
        {
            return "—";
        }

        var valor = cantidad.Value.ToString("0.##", CultureInfo.CurrentCulture);
        return string.IsNullOrWhiteSpace(unidad) ? valor : $"{valor} {unidad}".Trim();
    }

    private async Task OnEtiquetaImagenSeleccionada(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _labelImagenArchivoNombre = file.Name;
        await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var base64 = Convert.ToBase64String(ms.ToArray());
        _labelImagenDataUrl = $"data:{file.ContentType};base64,{base64}";
    }

    private string? EditQrText
    {
        get => _editQrText;
        set
        {
            _editQrText = value;
            _qrTexto = value;
            _qrImageUrl = string.IsNullOrWhiteSpace(value)
                ? null
                : $"https://api.qrserver.com/v1/create-qr-code/?size=120x120&data={Uri.EscapeDataString(value)}";
        }
    }

    private sealed record ContenedorLookup(string Id, string Label);

    private sealed record EtiquetaReactivo(
        string Id,
        string Nombre,
        string? NombreComercial,
        string? NombreQuimico,
        string? Cas,
        string? FormaFisica,
        string? Descripcion,
        string? Observaciones,
        string? ImagenUrl,
        string? Categoria,
        string? Subcategorias,
        bool Controlada
    );

    private static string FormatDate(DateTime? dt)
        => dt.HasValue ? dt.Value.ToString("dd/MM/yyyy") : "—";
}

