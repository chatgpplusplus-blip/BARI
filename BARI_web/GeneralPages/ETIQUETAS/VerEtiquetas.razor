    {
        if (!cantidad.HasValue) return "—";
        var valor = cantidad.Value.ToString("0.##", CultureInfo.CurrentCulture);
        return string.IsNullOrWhiteSpace(unidad) ? valor : $"{valor} {unidad}".Trim();
    }

