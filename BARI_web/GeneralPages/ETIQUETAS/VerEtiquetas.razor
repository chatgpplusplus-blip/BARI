@page "/ver-etiquetas"
@page "/ver-etiquetas/contenedor/{ContenedorId}"

@using Npgsql
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject NpgsqlDataSource DataSource
@inject LaboratorioState LaboratorioState
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Etiquetado de Sustancias</PageTitle>

<section class="page-card">
    <h2>Etiquetado de Reactivos</h2>
    <p>
        Visualizador inspirado en etiquetas tipo Merck. Selecciona un contenedor para ver y ajustar el diseño
        antes de imprimir. Puedes modificar campos y dimensiones.
    </p>
</section>

<section class="page-card" style="margin-top:1.5rem;">

    @if (_etiqueta is not null)
{
    <button class="btn btn-primary" type="button" @onclick="DescargarPdfAsync">
        Descargar esta imagen como PDF (se descargará con las dimensiones correctas)
    </button>
}


    <div class="label-controls">
        <div class="label-control">
            <label class="text-xs text-gray-500">Contenedor</label>
            <select class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_selectedContenedorId) ? "is-filled" : "")"
                    @onchange="OnContenedorChanged">
                <option value="">Del desplegable seleccione un contenedor para ver o editar</option>
                @foreach (var c in _contenedoresLookup)
                {
                    <option value="@c.Id" selected="@(c.Id == _selectedContenedorId)">@c.Label</option>
                }
            </select>
        </div>

        <div class="label-control">
            <label class="text-xs text-gray-500">Ancho (mm)</label>
            <input class="border p-1 form-control @(_labelWidthMm > 0 ? "is-filled" : "")"
                   type="number" min="20"
                   value="@_labelWidthMm"
                   @oninput="OnWidthInput" />
        </div>

        <div class="label-control">
            <label class="text-xs text-gray-500">Alto (mm)</label>
            <input class="border p-1 form-control @(_labelHeightMm > 0 ? "is-filled" : "")"
                   type="number" min="20"
                   value="@_labelHeightMm"
                   disabled="@_lockAspectRatio"
                   @oninput="OnHeightInput" />
            <label class="text-xs" style="margin-top:.35rem; display:flex; gap:.5rem; align-items:center;">
                <input type="checkbox" checked="@_lockAspectRatio" @onchange="OnLockRatioChanged" />
                <span class="text-gray-500">Bloquear proporción 2:1</span>
            </label>
        </div>

        <div class="label-control">
            <label class="text-xs text-gray-500">Modo</label>
            <div class="inline-radio">
                <label class="toggle @(!_previewFull ? "is-filled" : "")">
                    <input type="radio" name="preview-mode" value="print" checked="@(!_previewFull)"
                           @onchange="@(() => SetPreviewMode(false))" />
                    <span>Imprimible (auto-fit, sin scroll)</span>
                </label>
                <label class="toggle @(_previewFull ? "is-filled" : "")">
                    <input type="radio" name="preview-mode" value="full" checked="@(_previewFull)"
                           @onchange="@(() => SetPreviewMode(true))" />
                    <span>Completa (sin auto-fit)</span>
                </label>
            </div>
        </div>
    </div>
</section>

<section class="page-card" style="margin-top:1.5rem;">
    <div class="label-stack">

        <div class="label-preview">
            <h4>Vista previa de etiqueta</h4>

            <div class="label-frame-wrap">
                <div class="label-frame @( _previewFull ? "is-full" : "is-fit")"
                     style="@LabelFrameStyle"
                     @ref="_fitFrameRef">


                    @if (_etiqueta is null)
                    {
                        <div class="label-empty-preview">
                            @if (_loadError is not null)
                            {
                                <div class="error-note">No se pudo cargar el contenedor: @_loadError</div>
                            }
                            else
                            {
                                <div class="helper" style="text-align:center;">
                                    Abre <b>Opciones y editor</b> y selecciona un contenedor para ver la etiqueta.
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="label-inner @( _previewFull ? "mode-full" : "mode-fit" )"
                             style="@LabelInnerStyle"
                             @ref="_fitInnerRef">

                            <div class="label-card @CardLayoutClass" @ref="_exportRef">
                                <div class="lbl-topbar"></div>

                                <div class="lbl-header">
                                    <div class="lbl-brand-left">
                                        <img class="lbl-org-logo" src="@UpsaLogoUrl" alt="Logo UPSA" @onload="OnAnyImageLoaded" />
                                        <div class="lbl-brand-text">
                                            <div class="lbl-org">UPSA · Inventario</div>
                                            <div class="lbl-brand">@DisplayOrDash(_marcaNombre)</div>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(_marcaLogoUrl))
                                    {
                                        <img class="lbl-brand-logo" src="@_marcaLogoUrl" alt="Logo de marca" @onload="OnAnyImageLoaded" />
                                    }
                                </div>

                                <div class="lbl-body">
                                    <div class="lbl-left">
                                        <div class="lbl-title">@DisplayOrDash(_editNombrePrincipal)</div>
                                        <div class="lbl-signal">@DisplayOrDash(_editPalabraAdvertencia)</div>
                                        <div class="lbl-sub">@DisplayOrDash(_editNombreQuimico)</div>

                                        <div class="lbl-grid">
                                            <div class="pair"><span class="k">CAS</span><span class="v">@DisplayOrDash(_editCas)</span></div>
                                            <div class="pair"><span class="k">Forma</span><span class="v">@DisplayOrDash(_editFormaFisica)</span></div>
                                            <div class="pair"><span class="k">Categoría</span><span class="v">@DisplayOrDash(_editCategoria)</span></div>

                                            <div class="pair"><span class="k">Subcats</span><span class="v">@DisplayOrDash(_editSubcategorias)</span></div>
                                            <div class="pair"><span class="k">Advertencia</span><span class="v">@DisplayOrDash(_editPalabraAdvertencia)</span></div>
                                            <div class="pair"><span class="k">Concentración</span><span class="v">@DisplayOrDash(_editConcentracion)</span></div>
                                            <div class="pair"><span class="k">Contenedor</span><span class="v">@DisplayOrDash(_editContenedorId)</span></div>
                                            <div class="pair"><span class="k">Pureza</span><span class="v">@DisplayOrDash(_editPureza)</span></div>
                                            <div class="pair"><span class="k">Proveedor</span><span class="v">@DisplayOrDash(_editContProveedor)</span></div>

                                            <div class="pair"><span class="k">Condición</span><span class="v">@DisplayOrDash(_editContCondicion)</span></div>
                                            <div class="pair"><span class="k">Unidad</span><span class="v">@DisplayOrDash(_editContUnidad)</span></div>
                                            <div class="pair"><span class="k">Cant. total</span><span class="v">@GetStockDisplay()</span></div>

                                            <div class="pair"><span class="k">Cant. nominal</span><span class="v">@FormatCantidad(_editContCantidadNominal, _editContUnidad)</span></div>
                                            <div class="pair"><span class="k">Cant. actual</span><span class="v">@FormatCantidad(_editContCantidadActual, _editContUnidad)</span></div>
                                            <div class="pair"><span class="k">QR</span><span class="v">@GetQrShortLabelValue()</span></div>

                                            <div class="pair"><span class="k">Compra</span><span class="v">@FormatDate(_editFechaCompra)</span></div>
                                            <div class="pair"><span class="k">Recepción</span><span class="v">@FormatDate(_editFechaRecepcion)</span></div>
                                            <div class="pair"><span class="k">Apertura</span><span class="v">@FormatDate(_editFechaApertura)</span></div>

                                            <div class="pair"><span class="k">Vence</span><span class="v">@FormatDate(_editFechaVencimiento)</span></div>
                                            <div class="pair"><span class="k">Prov. dirección</span><span class="v">@DisplayOrDash(_editContProveedorDireccion)</span></div>
                                            <div class="pair"><span class="k">Tel. emergencia</span><span class="v">@DisplayOrDash(_editContProveedorTelefono)</span></div>
                                        </div>

                                        <div class="lbl-micro">
                                            <div class="micro-row">
                                                <span class="mk">H</span>
                                                <span class="mv">@DisplayOrDash(_hCodesText)</span>
                                            </div>
                                            <div class="micro-row">
                                                <span class="mk">P</span>
                                                <span class="mv">@DisplayOrDash(_pCodesText)</span>
                                            </div>
                                        </div>

                                        <div class="lbl-hp-details">
                                            <div class="hp-block">
                                                <div class="hp-title">Frases H</div>
                                                @if (_hDescriptions.Count == 0)
                                                {
                                                    <div class="hp-empty">—</div>
                                                }
                                                else
                                                {
                                                    <ul>
                                                        @foreach (var item in _hDescriptions)
                                                        {
                                                            <li>@item</li>
                                                        }
                                                    </ul>
                                                }
                                            </div>
                                            <div class="hp-block">
                                                <div class="hp-title">Frases P</div>
                                                @if (_pDescriptions.Count == 0)
                                                {
                                                    <div class="hp-empty">—</div>
                                                }
                                                else
                                                {
                                                    <ul>
                                                        @foreach (var item in _pDescriptions)
                                                        {
                                                            <li>@item</li>
                                                        }
                                                    </ul>
                                                }
                                            </div>
                                        </div>

                                        <div class="lbl-notes">
                                            <div class="note">
                                                <div class="nt">Descripción</div>
                                                <div class="nv">@DisplayOrDash(_editDescripcion)</div>
                                            </div>
                                            <div class="note">
                                                <div class="nt">Observaciones</div>
                                                <div class="nv">@DisplayOrDash(_editObservaciones)</div>
                                            </div>
                                        </div>

                                        <div class="lbl-footer">
                                            <span>Solo para uso en laboratorio.</span>
                                            @if (_etiqueta.Controlada)
                                            {
                                                <span class="danger-chip">Sustancia controlada</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="lbl-right">
                                        <div class="pictos" style="@PictosStyle">
                                            @if (_ghsIconUrls.Count > 0)
                                            {
                                                foreach (var icon in _ghsIconUrls.Take(GhsMaxIcons))
                                                {
                                                    <img src="@icon" alt="GHS" @onload="OnAnyImageLoaded" />
                                                }
                                            }
                                            else
                                            {
                                                <div class="no-pictos">Sin pictogramas</div>
                                            }
                                        </div>

                                        <div class="side-row">
                                            <div class="nfpa">
                                                @NFPA()
                                                <div class="nfpa-caption">NFPA</div>
                                            </div>

                                            <div class="qrbox">
                                                @if (!string.IsNullOrWhiteSpace(_qrImageUrl))
                                                {
                                                    <img src="@_qrImageUrl" alt="QR etiqueta" @onload="OnAnyImageLoaded" />
                                                }
                                                else
                                                {
                                                    <div class="no-qr">Sin QR</div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="label-accordion">
            <button type="button"
                    class="label-accordion-toggle @(_editorOpen ? "is-open" : "")"
                    @onclick="ToggleEditor">
                <span>@(_editorOpen ? "Ocultar opciones y editor" : "Mostrar opciones y editor")</span>
                <span class="chev">@(_editorOpen ? "▲" : "▼")</span>
            </button>

            @if (_editorOpen)
            {
                <div class="label-accordion-body">
                    @if (_etiqueta is null)
                    {
                        <div class="empty" style="margin-top:1rem;">
                            <div class="helper">Selecciona un contenedor para habilitar el editor.</div>
                        </div>
                    }
                    else
                    {
                        <div class="label-edit" style="margin-top:1rem;">
                            <h4>Campos editables</h4>

                            <div class="label-edit-section">
                                <div class="label-edit-title">Reactivo</div>
                                <div class="label-edit-grid">
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Nombre principal</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editNombrePrincipal) ? "is-filled" : "")"
                                               @bind="_editNombrePrincipal" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Nombre químico</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editNombreQuimico) ? "is-filled" : "")"
                                               @bind="_editNombreQuimico" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">CAS</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editCas) ? "is-filled" : "")"
                                               @bind="_editCas" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Forma física</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editFormaFisica) ? "is-filled" : "")"
                                               @bind="_editFormaFisica" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Categoría</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editCategoria) ? "is-filled" : "")"
                                               @bind="_editCategoria" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Palabra de advertencia</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editPalabraAdvertencia) ? "is-filled" : "")"
                                               @bind="_editPalabraAdvertencia" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Concentración</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editConcentracion) ? "is-filled" : "")"
                                               @bind="_editConcentracion" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Pureza</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editPureza) ? "is-filled" : "")"
                                               @bind="_editPureza" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Subcategorías</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editSubcategorias) ? "is-filled" : "")"
                                               @bind="_editSubcategorias" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field label-edit-wide">
                                        <label class="text-xs text-gray-500">Descripción</label>
                                        <textarea class="border p-1 form-control" rows="3"
                                                  @bind="_editDescripcion"
                                                  @bind:event="oninput"
                                                  @bind:after="MarkFit"></textarea>
                                    </div>
                                    <div class="label-edit-field label-edit-wide">
                                        <label class="text-xs text-gray-500">Observaciones</label>
                                        <textarea class="border p-1 form-control" rows="3"
                                                  @bind="_editObservaciones"
                                                  @bind:event="oninput"
                                                  @bind:after="MarkFit"></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="label-edit-section">
                                <div class="label-edit-title">Contenedor</div>
                                <div class="label-edit-grid">
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">ID contenedor</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editContenedorId) ? "is-filled" : "")"
                                               @bind="_editContenedorId" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">QR</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editQrText) ? "is-filled" : "")"
                                               @bind="EditQrText"
                                               @bind:event="oninput" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Cantidad nominal</label>
                                        <InputNumber TValue="decimal?" class="@ContCantidadNominalClass"
                                                     @bind-Value="_editContCantidadNominal"
                                                     @bind-Value:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Cantidad actual</label>
                                        <InputNumber TValue="decimal?" class="@ContCantidadActualClass"
                                                     @bind-Value="_editContCantidadActual"
                                                     @bind-Value:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Unidad</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editContUnidad) ? "is-filled" : "")"
                                               @bind="_editContUnidad" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Proveedor</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editContProveedor) ? "is-filled" : "")"
                                               @bind="_editContProveedor" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Proveedor dirección</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editContProveedorDireccion) ? "is-filled" : "")"
                                               @bind="_editContProveedorDireccion" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Tel. emergencia</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editContProveedorTelefono) ? "is-filled" : "")"
                                               @bind="_editContProveedorTelefono" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Condición</label>
                                        <input class="border p-1 form-control @(!string.IsNullOrWhiteSpace(_editContCondicion) ? "is-filled" : "")"
                                               @bind="_editContCondicion" @bind:event="oninput" @bind:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Fecha adquisición</label>
                                        <InputDate class="@FechaCompraClass" @bind-Value="_editFechaCompra" @bind-Value:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Fecha recepción</label>
                                        <InputDate class="@FechaRecepcionClass" @bind-Value="_editFechaRecepcion" @bind-Value:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Fecha apertura</label>
                                        <InputDate class="@FechaAperturaClass" @bind-Value="_editFechaApertura" @bind-Value:after="MarkFit" />
                                    </div>
                                    <div class="label-edit-field">
                                        <label class="text-xs text-gray-500">Fecha vencimiento</label>
                                        <InputDate class="@FechaVencimientoClass" @bind-Value="_editFechaVencimiento" @bind-Value:after="MarkFit" />
                                    </div>
                                </div>
                            </div>

                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public string? ContenedorId { get; set; }

    private const string CategoriaReactivoId = "reactivo-quimico";
    private const string UpsaLogoUrl = "https://vc4a.com/wp-content/uploads/2022/06/198068246_2916680591924255_5728041621538232491_n.jpg";

    private const double Aspect = 2.0;     // proporción objetivo al bloquear
    private const double DesignW = 900.0;  // canvas base px

    private readonly List<ContenedorLookup> _contenedoresLookup = new();
    private readonly List<string> _ghsIconUrls = new();

    private string? _selectedContenedorId;
    private string? _loadError;
    private EtiquetaReactivo? _etiqueta;

    private int _labelWidthMm = 200;
    private int _labelHeightMm = 100;
    private bool _lockAspectRatio = true;

    private bool _editorOpen = false;
    private void ToggleEditor() => _editorOpen = !_editorOpen;

    private bool _previewFull = false;

    private bool _fitPending = false;
    private bool _fitObserversActive = false;
    private ElementReference _fitFrameRef;
    private ElementReference _fitInnerRef;

    private string? _editNombrePrincipal;
    private string? _editNombreQuimico;
    private string? _editCas;
    private string? _editFormaFisica;
    private string? _editCategoria;
    private string? _editSubcategorias;
    private string? _editDescripcion;
    private string? _editObservaciones;
    private string? _editPalabraAdvertencia;
    private string? _editConcentracion;
    private string? _editPureza;

    private string? _editContenedorId;
    private string? _editQrText;
    private decimal? _editContCantidadNominal;
    private decimal? _editContCantidadActual;
    private string? _editContUnidad;
    private string? _editContProveedor;
    private string? _editContProveedorDireccion;
    private string? _editContProveedorTelefono;
    private string? _editContCondicion;
    private DateTime? _editFechaCompra;
    private DateTime? _editFechaRecepcion;
    private DateTime? _editFechaApertura;
    private DateTime? _editFechaVencimiento;

    private string? _romboSalud;
    private string? _romboInflamabilidad;
    private string? _romboReactividad;
    private string? _romboEspecial;

    private decimal? _stockTotal;
    private string? _stockUnidad;

    private string? _qrTexto;
    private string? _qrImageUrl;

    private string? _hCodesText;
    private string? _pCodesText;
    private readonly List<string> _hDescriptions = new();
    private readonly List<string> _pDescriptions = new();

    private string? _marcaNombre;
    private string? _marcaLogoUrl;

    private DateTime? _fechaCompra;
    private DateTime? _fechaRecepcion;
    private DateTime? _fechaApertura;
    private DateTime? _fechaVencimiento;
    private decimal? _contCantidadNominal;
    private decimal? _contCantidadActual;
    private string? _contUnidad;
    private string? _contProveedor;
    private string? _contProveedorDireccion;
    private string? _contProveedorTelefono;
    private string? _contCondicion;

    // ✅ Pictos: ahora soportamos “muchos” con grid 1/2/3 columnas y tamaños dinámicos
    private int GhsMaxIcons => 9;

    private int GhsCountShown => Math.Min(_ghsIconUrls.Count, GhsMaxIcons);

    private int GhsCols => GhsCountShown switch
    {
        <= 1 => 1,
        <= 4 => 2,
        _ => 3
    };

    private int GhsIconSizePx => GhsCountShown switch
    {
        0 => 86,
        1 => 120,
        2 => 104,
        3 => 92,
        4 => 84,
        5 => 72,
        6 => 68,
        7 => 62,
        8 => 60,
        _ => 56
    };

    private ElementReference _exportRef;

private async Task DescargarPdfAsync()
{
    if (_etiqueta is null) return;

    var fileName = $"Etiqueta-{_selectedContenedorId}.pdf";
    await JS.InvokeVoidAsync("labelExport.downloadPdf", _exportRef, _labelWidthMm, _labelHeightMm, fileName);
}


    private int GhsGapPx => GhsCountShown switch
    {
        <= 2 => 12,
        <= 4 => 10,
        _ => 8
    };

