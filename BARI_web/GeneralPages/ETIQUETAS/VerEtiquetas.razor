    private RenderFragment NFPA() => __builder =>
    {
        var salud = DisplayOrDash(_romboSalud);
        var inflam = DisplayOrDash(_romboInflamabilidad);
        var react = DisplayOrDash(_romboReactividad);
        var esp = DisplayOrDash(_romboEspecial);

        // Ajuste de fuente para "especial" (CO, COR, OX, W, etc.)
        var espLen = string.IsNullOrWhiteSpace(esp) ? 1 : esp.Length;
        var espFont = espLen <= 2 ? 18 : (espLen <= 4 ? 14 : 12);

        string tStyle(int size) =>
            $"font: 900 {size}px system-ui, -apple-system, Segoe UI, Roboto, Arial;" +
            $"fill:#000; stroke:#fff; stroke-width:4px; paint-order:stroke fill;" +
            $"dominant-baseline:middle;";

        __builder.AddMarkupContent(0, $@"
<svg viewBox='0 0 100 100' role='img' aria-label='NFPA' style='width:100%;height:100%;display:block;'>
  <defs>
    <!-- midpoints: TL(26,26) TR(74,26) BR(74,74) BL(26,74) -->
    <clipPath id='nf-top'><polygon points='50,2 74,26 50,50 26,26'/></clipPath>
    <clipPath id='nf-left'><polygon points='2,50 26,26 50,50 26,74'/></clipPath>
    <clipPath id='nf-right'><polygon points='98,50 74,26 50,50 74,74'/></clipPath>
    <clipPath id='nf-bottom'><polygon points='50,98 26,74 50,50 74,74'/></clipPath>
  </defs>

  <!-- ZONAS (rombos) -->
  <polygon points='50,2 74,26 50,50 26,26' fill='#b91c1c'/>   <!-- arriba: rojo -->
  <polygon points='2,50 26,26 50,50 26,74' fill='#1e3a8a'/>   <!-- izquierda: azul -->
  <polygon points='98,50 74,26 50,50 74,74' fill='#a16207'/>  <!-- derecha: amarillo/ámbar -->
  <polygon points='50,98 26,74 50,50 74,74' fill='#f8fafc'/>  <!-- abajo: blanco -->

  <!-- Contorno -->
  <polygon points='50,2 98,50 50,98 2,50' fill='none' stroke='#0b1220' stroke-width='3'/>

  <!-- Divisiones internas (hacia los midpoints) -->
  <line x1='26' y1='26' x2='50' y2='50' stroke='#0b1220' stroke-width='2'/>
  <line x1='74' y1='26' x2='50' y2='50' stroke='#0b1220' stroke-width='2'/>
  <line x1='74' y1='74' x2='50' y2='50' stroke='#0b1220' stroke-width='2'/>
  <line x1='26' y1='74' x2='50' y2='50' stroke='#0b1220' stroke-width='2'/>

  <!-- TEXTOS (centrados y recortados dentro de su zona) -->
  <text x='50' y='27' text-anchor='middle' style='{tStyle(26)}' clip-path='url(#nf-top)'>{inflam}</text>
  <text x='27' y='50' text-anchor='middle' style='{tStyle(26)}' clip-path='url(#nf-left)'>{salud}</text>
  <text x='73' y='50' text-anchor='middle' style='{tStyle(26)}' clip-path='url(#nf-right)'>{react}</text>
  <text x='50' y='73' text-anchor='middle' style='{tStyle(espFont)}' clip-path='url(#nf-bottom)'>{esp}</text>
</svg>
");
