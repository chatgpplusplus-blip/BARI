@page "/Mosquito"
@using System.Text
@using System.Text.Json
@using System.Net.Http
@using System.IO

@inject IWebHostEnvironment Env

@implements IAsyncDisposable

<div class="container">
    <div class="card mt-4">
        <div class="card-header bg-primary text-white">
            <h3>Panel ESP32 (MicroPython + HTTP directo)</h3>
        </div>

        <div class="card-body">

            <div class="alert alert-info">
                <div class="mb-1">
                    Este panel envía <strong>main.py / boot.py</strong> directo por <strong>HTTP</strong> al ESP32 (sin GitHub, sin compilar).
                </div>
                <div class="mb-0">
                    Requisito: el ESP32 debe estar corriendo el servidor MicroPython <code>api_server.py</code> (te lo dejo abajo).
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">ESP32 Base URL</label>
                    <input class="form-control" @bind="esp32BaseUrl" placeholder="Ej: http://192.168.1.50" />
                    <small class="text-muted">Debe ser accesible desde donde corre tu Blazor (misma LAN si es IP privada).</small>
                </div>

                <div class="col-md-6">
                    <label class="form-label">API Key (opcional, recomendado)</label>
                    <input type="password" class="form-control" @bind="apiKey" placeholder="Ej: 1234" />
                    <small class="text-muted">Se envía como header <code>X-Api-Key</code>. Configura lo mismo en el ESP32.</small>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap mb-3">
                <button class="btn btn-outline-primary" @onclick="ProbarConexionAsync" disabled="@enviando">Probar conexión</button>
                <button class="btn btn-outline-danger" @onclick="ResetAsync" disabled="@enviando">Reiniciar ESP32</button>

                <div class="form-check ms-2">
                    <input class="form-check-input" type="checkbox" id="chkAuto"
                           @bind="autoStatus" />
                    <label class="form-check-label" for="chkAuto">
                        Auto status (cada 3s)
                    </label>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="alert alert-secondary mb-2">
                        <strong>Estado HTTP:</strong> <span class="ms-2">@estadoHttp</span>
                    </div>

                    <div class="alert alert-dark mb-2">
                        <strong>Status ESP32:</strong> <span class="ms-2 text-success">@ultimoStatus</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ultimoError))
                    {
                        <div class="alert alert-warning mb-2">
                            <strong>Último error:</strong>
                            <div><small>@ultimoError</small></div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(ultimaRespuestaCruda))
                    {
                        <div class="mb-2">
                            <strong>Respuesta cruda:</strong>
                            <pre class="bg-dark text-light p-2" style="max-height: 220px; overflow:auto;">@ultimaRespuestaCruda</pre>
                        </div>
                    }
                </div>

                <div class="col-md-6">
                    <h5>Enviar comando por HTTP</h5>
                    <div class="input-group">
                        <input @bind="comandoEnviar" class="form-control" placeholder="Ej: LED_ON / LED_OFF / texto" />
                        <button class="btn btn-success" @onclick="EnviarComandoAsync" disabled="@enviando">Enviar</button>
                    </div>
                    <small class="text-muted">El ESP32 recibe en <code>POST /api/cmd</code>. Tú decides qué hace con ese comando en MicroPython.</small>
                </div>
            </div>

            <hr class="my-4" />

            <h4>Editar y enviar MicroPython</h4>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <h5>main.py</h5>
                    <textarea class="form-control"
                              style="min-height: 320px; font-family: Consolas, monospace; font-size: 0.9rem;"
                              @bind="mainPy">
                    </textarea>

                    <div class="d-flex gap-2 mt-2 flex-wrap">
                        <button class="btn btn-outline-secondary" @onclick="GuardarMainAsync" disabled="@enviando">Guardar main local</button>
                        <button class="btn btn-primary" @onclick="SubirMainAsync" disabled="@enviando">
                            @(enviando ? "Enviando..." : "Enviar main.py al ESP32")
                        </button>
                    </div>
                </div>

                <div class="col-md-6">
                    <h5>boot.py (opcional)</h5>
                    <textarea class="form-control"
                              style="min-height: 320px; font-family: Consolas, monospace; font-size: 0.9rem;"
                              @bind="bootPy">
                    </textarea>

                    <div class="d-flex gap-2 mt-2 flex-wrap">
                        <button class="btn btn-outline-secondary" @onclick="GuardarBootAsync" disabled="@enviando">Guardar boot local</button>
                        <button class="btn btn-warning" @onclick="SubirBootAsync" disabled="@enviando">
                            @(enviando ? "Enviando..." : "Enviar boot.py al ESP32")
                        </button>
                    </div>
                </div>
            </div>

            <div class="form-check mt-2">
                <input class="form-check-input" type="checkbox" id="chkReset"
                       @bind="resetDespuesDeSubir" />
                <label class="form-check-label" for="chkReset">
                    Reiniciar ESP32 después de subir archivos
                </label>
            </div>

            @if (!string.IsNullOrWhiteSpace(saveInfo))
            {
                <div class="mt-3">
                    <small class="text-muted">@saveInfo</small>
                </div>
            }

            <hr class="my-4" />

            <div class="alert alert-light">
                <strong>Cómo funciona (resumen):</strong>
                <ul class="mb-0">
                    <li>Tu Blazor manda JSON a <code>POST /api/fs/write</code> con <code>path</code> y <code>content_b64</code>.</li>
                    <li>El ESP32 decodifica base64 y escribe el archivo en su FS (<code>:/main.py</code> o <code>:/boot.py</code>).</li>
                    <li>Opcionalmente llamas <code>POST /api/reset</code> para que reinicie y ejecute el nuevo <code>main.py</code>.</li>
                </ul>
            </div>

        </div>
    </div>
</div>

@code {
    // ========= HTTP =========
    private static readonly HttpClient http = new HttpClient
        {
            Timeout = TimeSpan.FromSeconds(15)
        };

    // ========= UI =========
    private string esp32BaseUrl = "http://192.168.1.50";
    private string apiKey = "";
    private string estadoHttp = "Sin probar";
    private string ultimoStatus = "(sin status aún)";
    private string comandoEnviar = "";
    private string saveInfo = "";
    private string ultimoError = "";
    private string ultimaRespuestaCruda = "";
    private bool enviando = false;

    private bool resetDespuesDeSubir = true;
    private bool autoStatus = true;

    // ========= CÓDIGO =========
    private const string DefaultMainPy = @"print(""Hola desde main.py (MicroPython)!"")";

    private const string DefaultBootPy = @"# boot.py (opcional)
# Aquí normalmente conectas WiFi y arrancas tu API server.
# Si no lo necesitas, puedes dejarlo vacío.
";

    private string mainPy = DefaultMainPy;
    private string bootPy = DefaultBootPy;

    // ========= Persistencia local (servidor Blazor) =========
    private string UserCodeDir => Path.Combine(Env.ContentRootPath, "UserCode");
    private string MainPath => Path.Combine(UserCodeDir, "last_main.py");
    private string BootPath => Path.Combine(UserCodeDir, "last_boot.py");

    // ========= Polling =========
    private CancellationTokenSource? _pollCts;
    private Task? _pollTask;

    private sealed class ApiResult
    {
        public bool ok { get; set; }
        public string? error { get; set; }
        public string? path { get; set; }
        public int bytes { get; set; }
    }

    private sealed class ApiStatus
    {
        public bool ok { get; set; }
        public string? error { get; set; }
        public string? status { get; set; }
        public int free_mem { get; set; }
        public long uptime_ms { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        Directory.CreateDirectory(UserCodeDir);

        try
        {
            if (File.Exists(MainPath)) mainPy = await File.ReadAllTextAsync(MainPath);
        }
        catch { /* ignore */ }

        try
        {
            if (File.Exists(BootPath)) bootPy = await File.ReadAllTextAsync(BootPath);
        }
        catch { /* ignore */ }

        _pollCts = new CancellationTokenSource();
        _pollTask = PollLoopAsync(_pollCts.Token);
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (!autoStatus) continue;
                if (string.IsNullOrWhiteSpace(esp32BaseUrl)) continue;

                await GetStatusAsync(silent: true);
            }
        }
        catch (OperationCanceledException)
        {
            // normal
        }
        catch
        {
            // evita romper la página por polling
        }
    }

    private string NormalizeBaseUrl(string s)
    {
        s = (s ?? "").Trim();
        if (string.IsNullOrWhiteSpace(s)) return s;
        if (!s.StartsWith("http://", StringComparison.OrdinalIgnoreCase) &&
            !s.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            s = "http://" + s;
        }
        return s.TrimEnd('/');
    }

    private HttpRequestMessage NewRequest(HttpMethod method, string relativePath)
    {
        var baseUrl = NormalizeBaseUrl(esp32BaseUrl);
        var url = $"{baseUrl}{relativePath}";
        var req = new HttpRequestMessage(method, url);

        if (!string.IsNullOrWhiteSpace(apiKey))
        {
            req.Headers.TryAddWithoutValidation("X-Api-Key", apiKey.Trim());
        }

        return req;
    }

    private async Task<(bool ok, string raw, T? data, string err)> SendJsonAsync<T>(HttpMethod method, string path, object? payload)
    {
        var req = NewRequest(method, path);

        if (payload is not null)
        {
            var json = JsonSerializer.Serialize(payload);
            req.Content = new StringContent(json, Encoding.UTF8, "application/json");
        }

        using var resp = await http.SendAsync(req);
        var raw = await resp.Content.ReadAsStringAsync();

        if (!resp.IsSuccessStatusCode)
        {
            return (false, raw, default, $"HTTP {(int)resp.StatusCode} {resp.ReasonPhrase}");
        }

        try
        {
            var obj = JsonSerializer.Deserialize<T>(raw);
            return (true, raw, obj, "");
        }
        catch (Exception ex)
        {
            return (false, raw, default, "No pude parsear JSON: " + ex.Message);
        }
    }

    private async Task ProbarConexionAsync()
    {
        await GetStatusAsync(silent: false);
    }

    private async Task GetStatusAsync(bool silent)
    {
        ultimoError = "";
        saveInfo = "";

        try
        {
            estadoHttp = "Consultando /api/status...";
            StateHasChanged();

            var (ok, raw, data, err) = await SendJsonAsync<ApiStatus>(HttpMethod.Get, "/api/status", payload: null);
            ultimaRespuestaCruda = raw;

            if (!ok || data is null || !data.ok)
            {
                estadoHttp = "Sin conexión ❌";
                if (!silent) ultimoError = data?.error ?? err ?? "Error desconocido";
                return;
            }

            estadoHttp = "Conectado ✅";
            ultimoStatus = $"{data.status} | mem={data.free_mem} | uptime_ms={data.uptime_ms}";
        }
        catch (Exception ex)
        {
            estadoHttp = "Error ❌";
            if (!silent) ultimoError = ex.Message;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GuardarMainAsync()
    {
        try
        {
            Directory.CreateDirectory(UserCodeDir);
            await File.WriteAllTextAsync(MainPath, mainPy ?? "");
            saveInfo = "main.py guardado (last_main.py).";
        }
        catch (Exception ex)
        {
            saveInfo = "Error guardando main.py: " + ex.Message;
        }
    }

    private async Task GuardarBootAsync()
    {
        try
        {
            Directory.CreateDirectory(UserCodeDir);
            await File.WriteAllTextAsync(BootPath, bootPy ?? "");
            saveInfo = "boot.py guardado (last_boot.py).";
        }
        catch (Exception ex)
        {
            saveInfo = "Error guardando boot.py: " + ex.Message;
        }
    }

    private async Task SubirMainAsync()
    {
        await SubirArchivoAsync("/main.py", mainPy ?? "");
    }

    private async Task SubirBootAsync()
    {
        await SubirArchivoAsync("/boot.py", bootPy ?? "");
    }

    private async Task SubirArchivoAsync(string pathEnEsp, string contentText)
    {
        if (enviando) return;
        enviando = true;
        ultimoError = "";
        saveInfo = "";
        ultimaRespuestaCruda = "";

        try
        {
            // guardar copia local en el server Blazor
            if (pathEnEsp.Equals("/main.py", StringComparison.OrdinalIgnoreCase)) await GuardarMainAsync();
            if (pathEnEsp.Equals("/boot.py", StringComparison.OrdinalIgnoreCase)) await GuardarBootAsync();

            estadoHttp = $"Subiendo {pathEnEsp}...";
            StateHasChanged();

            var b64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(contentText));

            var payload = new
            {
                path = pathEnEsp,
                content_b64 = b64
            };

            var (ok, raw, data, err) = await SendJsonAsync<ApiResult>(HttpMethod.Post, "/api/fs/write", payload);
            ultimaRespuestaCruda = raw;

            if (!ok || data is null || !data.ok)
            {
                estadoHttp = "Falló la subida ❌";
                ultimoError = data?.error ?? err ?? "Error desconocido";
                return;
            }

            estadoHttp = "Subido ✅";
            saveInfo = $"ESP32 guardó {data.path} ({data.bytes} bytes).";

            if (resetDespuesDeSubir)
            {
                await ResetAsync();
            }
            else
            {
                // refrescar status
                await GetStatusAsync(silent: true);
            }
        }
        catch (Exception ex)
        {
            estadoHttp = "Error ❌";
            ultimoError = ex.ToString();
        }
        finally
        {
            enviando = false;
            StateHasChanged();
        }
    }

    private async Task EnviarComandoAsync()
    {
        if (enviando) return;
        if (string.IsNullOrWhiteSpace(comandoEnviar)) return;

        enviando = true;
        ultimoError = "";
        saveInfo = "";
        ultimaRespuestaCruda = "";

        try
        {
            estadoHttp = "Enviando comando...";
            StateHasChanged();

            var payload = new { cmd = comandoEnviar.Trim() };

            var (ok, raw, data, err) = await SendJsonAsync<ApiResult>(HttpMethod.Post, "/api/cmd", payload);
            ultimaRespuestaCruda = raw;

            if (!ok || data is null || !data.ok)
            {
                estadoHttp = "Falló comando ❌";
                ultimoError = data?.error ?? err ?? "Error desconocido";
                return;
            }

            estadoHttp = "Comando enviado ✅";
            saveInfo = $"Comando enviado: {comandoEnviar.Trim()}";
            comandoEnviar = "";

            await GetStatusAsync(silent: true);
        }
        catch (Exception ex)
        {
            estadoHttp = "Error ❌";
            ultimoError = ex.Message;
        }
        finally
        {
            enviando = false;
            StateHasChanged();
        }
    }

    private async Task ResetAsync()
    {
        ultimoError = "";
        saveInfo = "";
        ultimaRespuestaCruda = "";

        try
        {
            estadoHttp = "Reiniciando...";
            StateHasChanged();

            var (ok, raw, data, err) = await SendJsonAsync<ApiResult>(HttpMethod.Post, "/api/reset", new { });
            ultimaRespuestaCruda = raw;

            if (!ok || data is null || !data.ok)
            {
                estadoHttp = "No pude reiniciar ❌";
                ultimoError = data?.error ?? err ?? "Error desconocido";
                return;
            }

            estadoHttp = "Reset solicitado ✅";
            saveInfo = "El ESP32 debería reiniciar ahora.";

            // espera un poquito y reconsulta status
            await Task.Delay(1200);
            await GetStatusAsync(silent: true);
        }
        catch (Exception ex)
        {
            estadoHttp = "Error ❌";
            ultimoError = ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_pollCts is not null)
            {
                _pollCts.Cancel();
                _pollCts.Dispose();
            }
            if (_pollTask is not null)
            {
                // no forzamos await si ya canceló, pero intentamos
                try { await _pollTask; } catch { /* ignore */ }
            }
        }
        catch { /* ignore */ }
    }
}
