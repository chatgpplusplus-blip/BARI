@page "/Mosquito"
@using MQTTnet
@using System.Security.Cryptography
@using System.Text
@using System.Text.Json
@using System.IO

@inject IWebHostEnvironment Env
@inject IConfiguration Configuration

@implements IAsyncDisposable

<div class="container">
    <div class="card mt-4">
        <div class="card-header bg-primary text-white">
            <h3>Panel ESP32 (MQTT + MicroPython Update por HTTP)</h3>
        </div>

        <div class="card-body">

            <div class="row">
                <div class="col-md-6">
                    <h4>LOG (ESP32 → Web)</h4>

                    <div class="alert alert-dark mt-3">
                        <strong>Último log:</strong>
                        <span class="text-success">@ultimoLog</span>
                    </div>

                    <div class="alert alert-secondary mt-3">
                        <strong>Último status:</strong>
                        <span class="text-primary">@ultimoStatus</span>
                    </div>

                    <div><small class="text-muted">Estado MQTT: @estadoMqtt</small></div>
                </div>

                <div class="col-md-6">
                    <h4>Enviar Comando (Web → ESP32)</h4>
                    <div class="input-group">
                        <input @bind="comandoEnviar" class="form-control" placeholder="Ej: LED_ON / LED_OFF / texto" />
                        <button class="btn btn-success" @onclick="EnviarDato" disabled="@(!_mqttConectado)">Enviar</button>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <h4>Publicar y enviar <code>main.py</code> (MicroPython) por HTTP</h4>

            <div class="alert alert-info">
                <p class="mb-1">
                    La web <strong>publica</strong> tu código como un archivo HTTP:
                </p>
                <code>@PublicBaseUrl/mpy/&lt;archivo&gt;.py</code>
                <p class="mb-0">
                    Luego envía una orden por MQTT al topic:
                    <code>@TopicMpyHttp</code>
                    para que el ESP32 descargue el script y lo guarde en el path indicado.
                </p>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">WiFi SSID (opcional: actualizar credenciales)</label>
                    <input class="form-control" @bind="wifiSsid" placeholder="Ej: MI_RED" />
                    <small class="text-muted">
                        Si lo dejas vacío, el ESP32 mantiene su WiFi actual (según tu boot.py core).
                    </small>
                </div>

                <div class="col-md-4">
                    <label class="form-label">WiFi password (opcional)</label>
                    <input type="password" class="form-control" @bind="wifiPass" placeholder="********" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Nombre destino en el ESP32</label>
                    <input class="form-control" @bind="remotePath" />
                    <small class="text-muted">Por defecto: <code>/main.py</code></small>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Código MicroPython</label>

                <textarea class="form-control"
                          style="min-height: 320px; font-family: Consolas, monospace; font-size: 0.9rem;"
                          @bind="userCode"
                          @bind:event="oninput">
                </textarea>

                <div class="mt-2">
                    @if (!string.IsNullOrWhiteSpace(validacionError))
                    {
                        <div class="alert alert-danger py-2 mb-2">@validacionError</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(validacionWarn))
                    {
                        <div class="alert alert-warning py-2 mb-2">@validacionWarn</div>
                    }
                    else
                    {
                        <div class="alert alert-success py-2 mb-2">Validación OK ✅</div>
                    }
                </div>

                <small class="text-muted">
                    Recomendación: deja WiFi/MQTT en <code>boot.py</code> core fijo; aquí solo lógica del usuario.
                </small>
            </div>

            <div class="d-flex gap-2 mb-2 flex-wrap">
                <button class="btn btn-outline-secondary" @onclick="GuardarCodigoAsync">
                    Guardar código (lastcode.py)
                </button>

                <button class="btn btn-warning"
                        @onclick="PublicarYActualizarAsync"
                        disabled="@(!_mqttConectado || publicando || !PuedePublicar)">
                    @(publicando ? "Publicando y enviando..." : "Publicar por HTTP y actualizar ESP32")
                </button>

                <button class="btn btn-outline-primary"
                        @onclick="SolicitarInfoAsync"
                        disabled="@(!_mqttConectado)">
                    Consultar “código corriendo”
                </button>

                <button class="btn btn-outline-dark"
                        @onclick="LeerArchivoDelEspAsync"
                        disabled="@(!_mqttConectado || leyendoArchivo)">
                    @(leyendoArchivo ? "Leyendo main.py..." : "Leer main.py del ESP32 (hasta 64KB)")
                </button>

                @if (!string.IsNullOrWhiteSpace(codigoLeidoDelEsp))
                {
                    <button class="btn btn-outline-success" @onclick="CopiarCodigoEspAlEditor">
                        Copiar lo leído → editor
                    </button>
                }
            </div>

            <div class="mb-2">
                <strong>Estado publicación/update:</strong>
                <span class="ms-2">@publicacionEstado</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(publicacionInfo))
            {
                <div class="alert alert-light border mt-2">
                    <div><strong>URL:</strong> <code>@ultimaUrlPublicada</code></div>
                    <div><strong>Size:</strong> @ultimaSize bytes</div>
                    <div><strong>SHA256:</strong> <code>@ultimaSha256</code></div>
                    <div class="mt-2">
                        <small class="text-muted">@publicacionInfo</small>
                    </div>
                </div>
            }

            <hr class="my-4" />

            <h4>Estado “código corriendo” (según el ESP32)</h4>
            <div class="alert alert-secondary">
                <div><strong>Path:</strong> <code>@(espRunPath ?? "(sin datos)")</code></div>
                <div><strong>Size:</strong> @(espRunSize?.ToString() ?? "(sin datos)")</div>
                <div><strong>SHA256:</strong> <code>@(espRunSha ?? "(sin datos)")</code></div>
                <div><strong>IP:</strong> @(espIp ?? "(?)")</div>
                <div><strong>SSID:</strong> @(espSsid ?? "(?)")</div>
                <div class="mt-2">
                    @if (!string.IsNullOrWhiteSpace(ultimaSha256) && !string.IsNullOrWhiteSpace(espRunSha))
                    {
                        if (string.Equals(ultimaSha256, espRunSha, StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-success">Coincide con lo último publicado ✅</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">NO coincide con lo último publicado ⚠️</span>
                        }
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(infoEspEstado))
                {
                    <div class="mt-2"><small class="text-muted">@infoEspEstado</small></div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(estadoLecturaArchivo))
            {
                <div class="alert alert-info py-2">@estadoLecturaArchivo</div>
            }

            @if (!string.IsNullOrWhiteSpace(codigoLeidoDelEsp))
            {
                <div class="mb-2">
                    <strong>main.py leído del ESP32:</strong>
                    <pre class="bg-dark text-light p-2" style="max-height: 280px; overflow:auto;">@codigoLeidoDelEsp</pre>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(publicacionLog))
            {
                <div class="mb-2">
                    <strong>Log:</strong>
                    <pre class="bg-dark text-light p-2" style="max-height: 240px; overflow:auto;">@publicacionLog</pre>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // ================== CONFIG ==================
    private const string BaseTopic = "bari/esp32/bari1";
    private static string T(string tail) => $"{BaseTopic}/{tail}";

    private readonly string TopicCmd = T("comandos");
    private readonly string TopicLog = T("log");
    private readonly string TopicStatus = T("status");

    private readonly string TopicMpyHttp = T("mpy/http");
    private readonly string TopicMpyInfoGet = T("mpy/info/get");
    private readonly string TopicMpyInfo = T("mpy/info");
    private readonly string TopicMpyFileGet = T("mpy/file/get");
    private readonly string TopicMpyFileChunk = T("mpy/file/chunk");

    private string PublicBaseUrl =>
        (Configuration["PublicBaseUrl"] ?? "https://bari-f57y.onrender.com").TrimEnd('/');

    // ================== MQTT (estilo compatible) ==================
    private MQTTnet.MqttClientFactory? _factory;
    private object? _mqttClientObj; // guardamos el cliente real aquí

    private bool _mqttConectado => _mqttClientObj is not null && IsClientConnected(_mqttClientObj);

    private static bool IsClientConnected(object client)
    {
        try { dynamic c = client; return c.IsConnected == true; }
        catch { return false; }
    }

    // ================== UI / ESTADO ==================
    private string estadoMqtt = "Desconectado";
    private string comandoEnviar = "";

    private string ultimoLog = "(sin logs aún)";
    private string ultimoStatus = "(esperando...)";

    private string validacionError = "";
    private string validacionWarn = "";
    private bool PuedePublicar => string.IsNullOrWhiteSpace(validacionError);

    // Info ESP
    private string? espRunPath;
    private long? espRunSize;
    private string? espRunSha;
    private string? espIp;
    private string? espSsid;
    private string infoEspEstado = "";

    // Lectura archivo
    private bool leyendoArchivo = false;
    private string estadoLecturaArchivo = "";
    private string codigoLeidoDelEsp = "";
    private string? _fileReqId;
    private MemoryStream? _fileAcc;
    private int _fileSeqEsperado = 0;

    private const string DefaultUserCode = @"print(""Hola desde main.py (MicroPython)!"")
import machine, time
led = machine.Pin(2, machine.Pin.OUT)

while True:
    led.value(1)
    time.sleep(0.2)
    led.value(0)
    time.sleep(0.2)
";

    private string _userCode = DefaultUserCode;
    private string userCode
    {
        get => _userCode;
        set
        {
            _userCode = value ?? "";
            ValidarCodigo();
        }
    }

    private string wifiSsid = "";
    private string wifiPass = "";
    private string remotePath = "/main.py";

    private bool publicando = false;
    private string publicacionEstado = "";
    private string publicacionLog = "";
    private string publicacionInfo = "";

    private string ultimaUrlPublicada = "";
    private long ultimaSize = 0;
    private string ultimaSha256 = "";

    // lastcode.py
    private static readonly string UserCodeFileName = "lastcode.py";
    private string UserCodeDir => Path.Combine(Env.ContentRootPath, "UserCode");
    private string UserCodePath => Path.Combine(UserCodeDir, UserCodeFileName);

    // HTTP scripts
    private string MpyDir => Path.Combine(Env.WebRootPath, "mpy");

    // ================== INIT ==================
    protected override async Task OnInitializedAsync()
    {
        ValidarCodigo();

        _factory = new MQTTnet.MqttClientFactory();

        // IMPORTANTE: NO dynamic aquí (para poder usar += con eventos)
        var mqttClient = _factory.CreateMqttClient();
        _mqttClientObj = mqttClient;

        mqttClient.ConnectedAsync += async _ =>
        {
            estadoMqtt = "Conectado ✅";
            await InvokeAsync(StateHasChanged);
        };

        mqttClient.DisconnectedAsync += async _ =>
        {
            estadoMqtt = "Desconectado ❌";
            await InvokeAsync(StateHasChanged);
        };

        mqttClient.ApplicationMessageReceivedAsync += async e =>
        {
            var topic = e.ApplicationMessage.Topic ?? "";
            var text = e.ApplicationMessage.ConvertPayloadToString() ?? "";

            if (topic == TopicLog) ultimoLog = text;
            else if (topic == TopicStatus) ultimoStatus = text;
            else if (topic == TopicMpyInfo) ProcesarInfoEsp(text);
            else if (topic == TopicMpyFileChunk) ProcesarChunkArchivo(text);

            await InvokeAsync(StateHasChanged);
        };

        var options = _factory.CreateClientOptionsBuilder()
            .WithTcpServer("broker.emqx.io", 1883)
            .WithClientId($"BARI_web_{Guid.NewGuid():N}")
            .WithKeepAlivePeriod(TimeSpan.FromSeconds(30))
            .Build();

        try
        {
            estadoMqtt = "Conectando...";
            await mqttClient.ConnectAsync(options, CancellationToken.None);

            var subs = _factory.CreateSubscribeOptionsBuilder()
                .WithTopicFilter(TopicLog)
                .WithTopicFilter(TopicStatus)
                .WithTopicFilter(TopicMpyInfo)
                .WithTopicFilter(TopicMpyFileChunk)
                .Build();

            await mqttClient.SubscribeAsync(subs, CancellationToken.None);
        }
        catch (Exception ex)
        {
            estadoMqtt = "Error MQTT: " + ex.Message;
        }

        // cargar lastcode.py
        try
        {
            Directory.CreateDirectory(UserCodeDir);
            if (File.Exists(UserCodePath))
            {
                userCode = await File.ReadAllTextAsync(UserCodePath);
            }
            else
            {
                userCode = DefaultUserCode;
                await File.WriteAllTextAsync(UserCodePath, userCode);
            }
        }
        catch { }
    }

    private string NormalizarRemotePath()
    {
        var p = (remotePath ?? "/main.py").Trim();
        if (string.IsNullOrWhiteSpace(p)) p = "/main.py";
        if (!p.StartsWith("/")) p = "/" + p;
        return p;
    }

    private void ValidarCodigo()
    {
        validacionError = "";
        validacionWarn = "";

        var code = userCode ?? "";
        if (string.IsNullOrWhiteSpace(code))
        {
            validacionError = "El código está vacío.";
            return;
        }

        var lower = code.ToLowerInvariant();
        if (lower.Contains("#include") || lower.Contains("void setup") || lower.Contains("void loop") || lower.Contains(".ino"))
        {
            validacionError = "Esto parece Arduino/C++. Aquí debe ir MicroPython.";
            return;
        }

        if (code.Length > 64_000)
        {
            validacionError = "Código demasiado grande (>64KB). Reduce el tamaño.";
            return;
        }

        if (lower.Contains("import network") || lower.Contains("umqtt"))
        {
            validacionWarn = "Ojo: normalmente WiFi/MQTT van en boot.py core, no en main.py del usuario.";
        }
    }

    // ================== MQTT: COMANDOS ==================
    private async Task EnviarDato()
    {
        if (_mqttClientObj is null) return;
        dynamic mqttClient = _mqttClientObj;

        var msg = new MqttApplicationMessageBuilder()
            .WithTopic(TopicCmd)
            .WithPayload(comandoEnviar ?? "")
            .Build();

        await mqttClient.PublishAsync(msg, CancellationToken.None);
        comandoEnviar = "";
    }

    // ================== GUARDAR ==================
    private async Task GuardarCodigoAsync()
    {
        try
        {
            Directory.CreateDirectory(UserCodeDir);
            await File.WriteAllTextAsync(UserCodePath, userCode ?? string.Empty);
            publicacionEstado = $"Código guardado en {UserCodeFileName}";
            publicacionLog = "";
        }
        catch (Exception ex)
        {
            publicacionEstado = "Error guardando código";
            publicacionLog = ex.ToString();
        }

        StateHasChanged();
    }

    // ================== UPDATE ==================
    private sealed class MpyUpdateMessage
    {
        public string type { get; set; } = "mpy_http_update";
        public string url { get; set; } = "";
        public string path { get; set; } = "/main.py";
        public long size { get; set; }
        public string sha256 { get; set; } = "";
        public string? ssid { get; set; }
        public string? pass { get; set; }
    }

    private async Task PublicarYActualizarAsync()
    {
        if (!_mqttConectado || publicando) return;
        if (!PuedePublicar) return;

        publicando = true;
        publicacionEstado = "Guardando código...";
        publicacionLog = "";
        publicacionInfo = "";
        ultimaUrlPublicada = "";
        ultimaSha256 = "";
        ultimaSize = 0;
        StateHasChanged();

        try
        {
            await GuardarCodigoAsync();

            Directory.CreateDirectory(MpyDir);

            var storedName = $"{DateTime.UtcNow:yyyyMMdd_HHmmss}_{Guid.NewGuid():N}.py";
            var fullDest = Path.Combine(MpyDir, storedName);

            var codeText = userCode ?? "";
            await File.WriteAllTextAsync(fullDest, codeText, Encoding.UTF8);

            var fileInfo = new FileInfo(fullDest);
            ultimaSize = fileInfo.Length;

            using var sha = SHA256.Create();
            await using (var fs = File.OpenRead(fullDest))
            {
                var hash = await sha.ComputeHashAsync(fs);
                ultimaSha256 = Convert.ToHexString(hash).ToLowerInvariant();
            }

            ultimaUrlPublicada = $"{PublicBaseUrl}/mpy/{storedName}";
            var path = NormalizarRemotePath();

            var msgObj = new MpyUpdateMessage
                {
                    url = ultimaUrlPublicada,
                    path = path,
                    size = ultimaSize,
                    sha256 = ultimaSha256,
                };

            if (!string.IsNullOrWhiteSpace(wifiSsid))
            {
                msgObj.ssid = wifiSsid.Trim();
                msgObj.pass = wifiPass ?? "";
            }

            var json = JsonSerializer.Serialize(msgObj);

            publicacionEstado = "Enviando orden de update por MQTT...";
            StateHasChanged();

            dynamic mqttClient = _mqttClientObj!;
            var mqttMsg = new MqttApplicationMessageBuilder()
                .WithTopic(TopicMpyHttp)
                .WithPayload(json)
                .Build();

            await mqttClient.PublishAsync(mqttMsg, CancellationToken.None);

            publicacionEstado = "Enviado ✅ (ESP32 debe descargar, escribir y reiniciar)";
            publicacionInfo = $"ESP32: descarga {msgObj.url} → verifica SHA256 → escribe {msgObj.path} → reinicia.";
        }
        catch (Exception ex)
        {
            publicacionEstado = "Error publicando / enviando update";
            publicacionLog = ex.ToString();
        }
        finally
        {
            publicando = false;
            StateHasChanged();
        }
    }

    // ================== INFO GET ==================
    private sealed class MpyInfoGetReq
    {
        public string type { get; set; } = "mpy_info_get";
        public string path { get; set; } = "/main.py";
    }

    private sealed class MpyInfoResp
    {
        public string? type { get; set; }
        public string? path { get; set; }
        public long? size { get; set; }
        public string? sha256 { get; set; }
        public string? ip { get; set; }
        public string? ssid { get; set; }
        public string? msg { get; set; }
    }

    private async Task SolicitarInfoAsync()
    {
        if (_mqttClientObj is null) return;
        dynamic mqttClient = _mqttClientObj;

        var req = new MpyInfoGetReq { path = NormalizarRemotePath() };
        var json = JsonSerializer.Serialize(req);

        infoEspEstado = "Solicitando info al ESP32...";
        StateHasChanged();

        var mqttMsg = new MqttApplicationMessageBuilder()
            .WithTopic(TopicMpyInfoGet)
            .WithPayload(json)
            .Build();

        await mqttClient.PublishAsync(mqttMsg, CancellationToken.None);
    }

    private void ProcesarInfoEsp(string payload)
    {
        try
        {
            var resp = JsonSerializer.Deserialize<MpyInfoResp>(payload);
            if (resp is null) return;

            if (!string.IsNullOrWhiteSpace(resp.path)) espRunPath = resp.path;
            if (resp.size.HasValue) espRunSize = resp.size.Value;
            if (!string.IsNullOrWhiteSpace(resp.sha256)) espRunSha = resp.sha256;
            if (!string.IsNullOrWhiteSpace(resp.ip)) espIp = resp.ip;
            if (!string.IsNullOrWhiteSpace(resp.ssid)) espSsid = resp.ssid;

            infoEspEstado = resp.msg ?? "Info recibida ✅";
        }
        catch
        {
            infoEspEstado = payload;
        }
    }

    // ================== FILE GET (chunks) ==================
    private sealed class MpyFileGetReq
    {
        public string type { get; set; } = "mpy_file_get";
        public string id { get; set; } = "";
        public string path { get; set; } = "/main.py";
        public int chunk { get; set; } = 1024;
        public int max { get; set; } = 65536;
    }

    private sealed class MpyFileChunk
    {
        public string? type { get; set; }
        public string? id { get; set; }
        public int? seq { get; set; }
        public bool? eof { get; set; }
        public string? b64 { get; set; }
        public string? error { get; set; }
    }

    private async Task LeerArchivoDelEspAsync()
    {
        if (_mqttClientObj is null || leyendoArchivo) return;
        dynamic mqttClient = _mqttClientObj;

        leyendoArchivo = true;
        estadoLecturaArchivo = "Solicitando main.py al ESP32...";
        codigoLeidoDelEsp = "";
        _fileReqId = Guid.NewGuid().ToString("N");
        _fileAcc = new MemoryStream();
        _fileSeqEsperado = 0;

        var req = new MpyFileGetReq
            {
                id = _fileReqId,
                path = NormalizarRemotePath(),
                chunk = 1024,
                max = 65536
            };

        var json = JsonSerializer.Serialize(req);

        var mqttMsg = new MqttApplicationMessageBuilder()
            .WithTopic(TopicMpyFileGet)
            .WithPayload(json)
            .Build();

        await mqttClient.PublishAsync(mqttMsg, CancellationToken.None);
        StateHasChanged();
    }

    private void ProcesarChunkArchivo(string payload)
    {
        MpyFileChunk? ch = null;
        try { ch = JsonSerializer.Deserialize<MpyFileChunk>(payload); }
        catch { return; }

        if (ch is null || string.IsNullOrWhiteSpace(ch.id) || _fileReqId is null) return;
        if (!string.Equals(ch.id, _fileReqId, StringComparison.OrdinalIgnoreCase)) return;

        if (!string.IsNullOrWhiteSpace(ch.error))
        {
            estadoLecturaArchivo = "Error leyendo archivo: " + ch.error;
            leyendoArchivo = false;
            _fileReqId = null;
            _fileAcc?.Dispose();
            _fileAcc = null;
            return;
        }

        if (ch.seq.HasValue && ch.seq.Value != _fileSeqEsperado)
        {
            estadoLecturaArchivo = $"Chunk fuera de orden. Esperado={_fileSeqEsperado} llegó={ch.seq.Value}";
        }

        if (!string.IsNullOrWhiteSpace(ch.b64) && _fileAcc is not null)
        {
            try
            {
                var bytes = Convert.FromBase64String(ch.b64);
                _fileAcc.Write(bytes, 0, bytes.Length);
                _fileSeqEsperado++;
                estadoLecturaArchivo = $"Recibiendo... {_fileAcc.Length} bytes";
            }
            catch
            {
                estadoLecturaArchivo = "Error decodificando base64 del ESP.";
            }
        }

        if (ch.eof == true)
        {
            try
            {
                var text = Encoding.UTF8.GetString(_fileAcc?.ToArray() ?? Array.Empty<byte>());
                codigoLeidoDelEsp = text;
                estadoLecturaArchivo = $"Listo ✅ leídos {(_fileAcc?.Length ?? 0)} bytes.";
            }
            finally
            {
                leyendoArchivo = false;
                _fileReqId = null;
                _fileAcc?.Dispose();
                _fileAcc = null;
            }
        }
    }

    private void CopiarCodigoEspAlEditor()
    {
        if (!string.IsNullOrWhiteSpace(codigoLeidoDelEsp))
        {
            userCode = codigoLeidoDelEsp;
        }
    }

    // ================== DISPOSE ==================
    public async ValueTask DisposeAsync()
    {
        if (_mqttClientObj is null) return;

        try
        {
            dynamic mqttClient = _mqttClientObj;
            await mqttClient.DisconnectAsync();
        }
        catch { }
        finally
        {
            if (_mqttClientObj is IDisposable d)
                d.Dispose();
        }
    }
}
