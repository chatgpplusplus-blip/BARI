    private string SelectedMesonLabel =>
        _nuevoMaterialMesonIds.Count == 0
            ? "Mesón"
            : string.Join(", ", _mesonOptions
                .Where(m => _nuevoMaterialMesonIds.Contains(m.Id, StringComparer.OrdinalIgnoreCase))
