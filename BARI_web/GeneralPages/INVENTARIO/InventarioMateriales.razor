    private async Task LoadCajasAsync()
    {
        _cajaOptions.Clear();

        if (_nuevoMaterialMesonIds.Count == 0)
        {
            _nuevoMaterialCajaIds.Clear();
            return;
        }

        await using var conn = await DataSource.OpenConnectionAsync();
        const string sql = @"
            SELECT c.caja_id,
                   c.meson_id,
                   COALESCE(m.nombre_meson, c.meson_id) AS meson_nombre,
                   c.nivel,
                   c.dimensiones
            FROM cajas c
            LEFT JOIN mesones m ON m.meson_id = c.meson_id
            WHERE c.meson_id = ANY(@mesones)
            ORDER BY meson_nombre, c.nivel, c.caja_id";

        await using var cmd = new NpgsqlCommand(sql, conn);
        cmd.Parameters.AddWithValue("mesones", _nuevoMaterialMesonIds.ToArray());
        await using var r = await cmd.ExecuteReaderAsync();
        while (await r.ReadAsync())
        {
            var cajaId = r.GetString(0);
            var mesonId = r.IsDBNull(1) ? "" : r.GetString(1);
            var mesonNombre = r.IsDBNull(2) ? "" : r.GetString(2);
            var nivel = r.IsDBNull(3) ? 0 : r.GetInt32(3);
            var dimensiones = r.IsDBNull(4) ? "" : r.GetString(4);

            var label = $"{cajaId} · {mesonNombre} · nivel {nivel}";
            if (!string.IsNullOrWhiteSpace(dimensiones))
                label = $"{label} · {dimensiones}";

            _cajaOptions.Add(new SelectOption(cajaId, label));
        }

        _nuevoMaterialCajaIds.RemoveAll(id => !_cajaOptions.Any(opt => string.Equals(opt.Id, id, StringComparison.OrdinalIgnoreCase)));
    }

