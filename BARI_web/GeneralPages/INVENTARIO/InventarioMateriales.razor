        {
            foreach (var v in values.Where(v => !string.IsNullOrWhiteSpace(v)))
                _nuevoMaterialMesonIds.Add(v);
        }
        else if (args.Value is IEnumerable<string> listValues)
        {
            foreach (var v in listValues.Where(v => !string.IsNullOrWhiteSpace(v)))
