@page "/detalles-area-3d/{AreaSlug}"
@namespace BARI_web.Features.Espacios.Pages
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Vista 3D · @AreaSlug</PageTitle>

<section class="page-card">
    <div class="toolbar">
        <div class="toolbar-left">
            <h2 class="toolbar-title">Vista 3D (conceptual) · @AreaSlug</h2>
        </div>
        <div class="toolbar-actions">
            <button type="button" class="btn" @onclick="@(() => Nav.NavigateTo($"/detalles/{AreaSlug}"))">
                ← Volver al detalle 2D
            </button>
            <button type="button" class="btn primary" @onclick="@(() => Nav.NavigateTo("/descarga"))">
                Descargar inventarios
            </button>
        </div>
    </div>

    <div class="helper" style="margin-top:.25rem;">
        Esta vista muestra volúmenes simplificados (sin realismo), usando las dimensiones registradas del área,
        mesones e instalaciones.
    </div>
</section>

<section class="page-card" style="margin-top:1rem;">
    <h3 style="margin-bottom:.5rem;">Estándares usados</h3>
    <ul style="margin:0; padding-left:1.1rem;">
        <li>Puertas: altura estándar de <strong>2.0 m</strong>.</li>
        <li>Ventanas: elevación desde el suelo de <strong>1.8 m</strong> y altura propia de <strong>1.5 m</strong>.</li>
        <li>Instalaciones elevadas: se respeta el levantamiento (altura desde el suelo) cuando exista.</li>
    </ul>
</section>

<section class="page-card" style="margin-top:1rem;">
    <h3 style="margin-bottom:.5rem;">Qué se visualiza</h3>
    <div class="info-grid">
        <div>
            <strong>Área (volumen)</strong>
            <div>Contorno del área extruido a su altura registrada.</div>
        </div>
        <div>
            <strong>Mesones e instalaciones</strong>
            <div>Bloques con ancho × largo × altura registrados.</div>
        </div>
        <div>
            <strong>Puertas y ventanas</strong>
            <div>Se proyectan sobre los muros con las alturas estándar indicadas.</div>
        </div>
        <div>
            <strong>Relaciones</strong>
            <div>La ubicación respeta el canvas y el posicionamiento de bloques.</div>
        </div>
    </div>
</section>

<section class="page-card" style="margin-top:1rem;">
    <div class="section-header">
        <h3 style="margin-bottom:0;">Vista 3D</h3>
        <div class="helper">
            Arrastra para rotar, usa rueda del mouse para zoom y botón derecho para desplazar.
        </div>
    </div>
    @if (IsLoading)
    {
        <div class="area-3d-canvas loading" role="status">Cargando vista 3D...</div>
    }
    else if (_areaData is null)
    {
        <div class="area-3d-canvas loading" role="status">No hay datos para renderizar.</div>
    }
    else
    {
        <div id="area-3d-canvas" class="area-3d-canvas" role="img" aria-label="Vista 3D del área"></div>
    }
</section>

<section class="page-card" style="margin-top:1rem;">
    <h3 style="margin-bottom:.5rem;">Pendientes para un 3D más realista</h3>
    <ul style="margin:0; padding-left:1.1rem;">
        <li>Texturas y modelos detallados (mobiliario, equipos, materiales).</li>
        <li>Rotación de elementos y espesores de muro configurables.</li>
        <li>Iluminación realista por área o por planta.</li>
    </ul>
</section>

@code {
    private bool _jsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _jsInitialized || _areaData is null || IsLoading) return;
        await Js.InvokeVoidAsync("Bari3D.initArea3D", "area-3d-canvas", _areaData);
        _jsInitialized = true;
    }
}

<style>
    .area-3d-canvas {
        width: 100%;
        height: min(70vh, 640px);
        border-radius: 12px;
        background: #0b1220;
        overflow: hidden;
        border: 1px solid rgba(148, 163, 184, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #cbd5f5;
        font-size: 0.95rem;
    }

    .area-3d-canvas.loading {
        background: linear-gradient(135deg, #0b1220 0%, #111827 100%);
    }
</style>
